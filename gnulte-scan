VERSION="1.2"

# -----------------------------------------------------------------------------
# Colors
# -----------------------------------------------------------------------------
C_RESET="\e[0m"; C_BOLD="\e[1m"; C_DIM="\e[2m"
C_RED="\e[31m"; C_GREEN="\e[32m"; C_YELLOW="\e[33m"; C_CYAN="\e[36m"; C_MAGENTA="\e[35m"

# -----------------------------------------------------------------------------
# Defaults
# -----------------------------------------------------------------------------
INTERFACE=""
CIDR=""
THREADS=32
DEEP=false
OUT_FORMAT="table"     # table | json | yaml | csv
QUIET=false
MY_NAME="gnulte-scan"
declare -gA VENDOR_MAP=()

SAFETY_POLICY_VERSION=1
GNULTE_ACCEPTANCE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gnulte"
GNULTE_ACCEPTANCE_FILE="$GNULTE_ACCEPTANCE_DIR/acceptance"
GNULTE_DOC_DIR="${GNULTE_DOC_DIR:-}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

usage() {
    cat <<EOF
${MY_NAME} ${VERSION} — LAN device discovery & fingerprinting

Scans the local network and reports every active device with as much detail
as possible: vendor, hostname (rDNS + mDNS + NetBIOS), type, gateway flag,
open ports and OS fingerprint (with --deep).

USAGE:
  ${MY_NAME} [OPTIONS]

OPTIONS:
  -i, --interface <IFACE>   Network interface (default: auto-detect)
  -C, --cidr <CIDR>         Subnet to scan, e.g. 192.168.1.0/24 (default: auto)
  -t, --threads <N>         Parallel ping sweep threads (default: 32)
  -d, --deep                Also run nmap: open ports + OS fingerprint
                            (labeled as active recon; slower; root helps OS detection)
  -j, --json                JSON export
  -y, --yaml                YAML export
  -c, --csv                 CSV export (ip,mac,vendor,hostname,type,ports,os)
  -q, --quiet               Only print the results table, no banners
  -h, --help                Show this help

EXAMPLES:
  ${MY_NAME}
  ${MY_NAME} -d                    Deep scan (ports + OS)
  ${MY_NAME} -j > devices.json
  ${MY_NAME} -i wlan0 -C 192.168.0.0/24 --deep -c

NOTES:
  * Use on networks you own or are authorized to test.
  * IPv4 only — IPv6 hosts are not enumerated in this version.
  * The "Type" column is a LIKELY guess derived from OUI vendor + hostname,
    not a guaranteed identification.
  * Hostnames prefer mDNS/avahi when available (avahi-tools), then reverse
    DNS, then NetBIOS (samba-utils). Install them for best results:
      Arch:   sudo pacman -S avahi nss-mdns samba nmap
      Debian: sudo apt install avahi-utils samba-utils nmap
  * Vendor names come from arp-scan (needs root) or the kernel neighbor table.
EOF
    exit 0
}

# Strict IPv4 validity check (4 octets, each 0-255)
valid_ip4() {
    local ip="$1" oct et
    [[ "$ip" =~ ^[0-9.]+$ ]] || return 1
    IFS=. read -ra oct <<< "$ip"
    [ "${#oct[@]}" -eq 4 ] || return 1
    for et in "${oct[@]}"; do
        [[ "$et" =~ ^[0-9]{1,3}$ ]] && [ "$et" -le 255 ] || return 1
    done
    return 0
}

valid_mac() {
    [[ "$1" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]]
}

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
ok()   { echo -e "${C_GREEN}OK:${C_RESET} $*"; }
warn() { echo -e "${C_YELLOW}WARN:${C_RESET} $*"; }
err()  { echo -e "${C_RED}ERROR:${C_RESET} $*" >&2; }
log()  { echo -e "$*"; }

# -----------------------------------------------------------------------------
# Legal / safety first-run gate (shared acceptance record with GNULTE)
# -----------------------------------------------------------------------------
scan_find_doc() {
    local name="$1" d f=""
    for d in "$GNULTE_DOC_DIR" "$SCRIPT_DIR" /usr/local/share/doc/gnulte /usr/share/doc/gnulte; do
        [ -n "$d" ] || continue
        f="$d/$name"
        [ -f "$f" ] && { echo "$f"; return 0; }
    done
    return 1
}

scan_read_doc() {
    local name="$1" f
    f="$(scan_find_doc "$name")"
    if [ -n "$f" ]; then
        cat "$f"
    else
        case "$name" in
            LICENSE)         echo "GNU GPL version 3 or later. See LICENSE in the repository." ;;
            FIRST-RUN-NOTICE.md)
                echo "GNULTE / GNULTE-SCAN can discover devices, perform active"
                echo "reconnaissance (--deep), capture traffic, and impair networks."
                echo "Use them only where you are authorized and the activity is lawful." ;;
            *)               echo "$name — see the GNULTE repository for the full document." ;;
        esac
    fi
}

scan_acceptance_current() {
    [ -f "$GNULTE_ACCEPTANCE_FILE" ] || return 1
    [ "$(sed -n 's/^SAFETY_POLICY_VERSION=//p' "$GNULTE_ACCEPTANCE_FILE" 2>/dev/null | tail -1)" = "$SAFETY_POLICY_VERSION" ]
}

scan_onboarding() {
    local -a docs=(LICENSE SAFETY.md DISCLAIMER.md AUTHORIZED-USE.md NETWORK-TESTING.md)
    local i=0 name ack ch

    echo ""
    echo -e "${C_RED}════════════════════════════════════════════════════════════════${C_RESET}"
    echo -e "${C_BOLD}                    GNULTE FIRST RUN (gnulte-scan)${C_RESET}"
    echo -e "${C_RED}════════════════════════════════════════════════════════════════${C_RESET}"
    echo ""
    scan_read_doc FIRST-RUN-NOTICE.md
    echo ""
    echo -e "${C_BOLD}Required documents:${C_RESET}"
    for i in "${!docs[@]}"; do
        echo "  [$((i+1))] ${docs[$i]}"
    done
    echo ""
    read -p "Press Enter to review, or 'Q' to quit: " go
    case "${go^^}" in Q) echo "Exiting — no scan was performed."; exit 1 ;; esac

    i=0
    while [ "$i" -lt "${#docs[@]}" ]; do
        name="${docs[$i]}"
        echo ""
        echo -e "${C_BOLD}◆ Document [$((i+1))/${#docs[@]}]: ${name}${C_RESET}"
        scan_read_doc "$name"
        echo -e "${C_DIM}  [R] restart document   [C] continue to acknowledgment   [Q] quit${C_RESET}"
        read -p "  Choice: " ch
        case "${ch^^}" in
            R) continue ;;
            Q) echo -e "${C_RED}Review stopped; no scan will be performed.${C_RESET}"; exit 1 ;;
            C|"") ;;
            *) echo -e "${C_DIM}    Please choose R, C or Q.${C_RESET}"; continue ;;
        esac
        read -p "  I have reviewed this document. [y/N]: " ack
        case "$ack" in
            y|Y) i=$((i+1)) ;;
            *) echo -e "${C_RED}Not acknowledged. Exiting — no scan was performed.${C_RESET}"; exit 1 ;;
        esac
    done

    mkdir -p "$GNULTE_ACCEPTANCE_DIR" || exit 1
    ( umask 077; printf 'SAFETY_POLICY_VERSION=%s\nSAFETY_ACKNOWLEDGED=1\nDISCLAIMER_ACKNOWLEDGED=1\nAUTHORIZATION_ACKNOWLEDGED=1\nNETWORK_TESTING_ACKNOWLEDGED=1\nTIMESTAMP=%s\n' \
        "$SAFETY_POLICY_VERSION" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$GNULTE_ACCEPTANCE_FILE" )
    echo ""
    echo -e "${C_GREEN}You have been shown the required documents and acknowledged the"
    echo -e "safety and authorization requirements.${C_RESET}"
    echo ""
}

scan_check_acceptance() {
    scan_acceptance_current && return 0
    if [ ! -t 0 ]; then
        err "First-run safety acknowledgment must be completed interactively."
        err "Run gnulte-scan from a terminal to review the required documents."
        exit 1
    fi
    scan_onboarding
}

spinner() {
    local pid=$1 msg=$2
    local s=("|" "/" "-" "\\")
    local i=0
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r  ${C_CYAN}%s${C_RESET} %s" "${s[$i]}" "$msg"
        i=$(((i+1)%4))
        sleep 0.1
    done
    printf "\r%*s\r" "$(( ${#msg} + 8 ))" ""
}

# -----------------------------------------------------------------------------
# Network configuration
# -----------------------------------------------------------------------------
detect_network() {
    if [ -z "$INTERFACE" ]; then
        INTERFACE=$(ip route | awk '/default/{print $5; exit}')
    fi
    if [ -z "$INTERFACE" ]; then
        err "Could not detect a network interface."
        exit 1
    fi
    ip link show "$INTERFACE" >/dev/null 2>&1 || { err "Interface $INTERFACE does not exist."; exit 1; }

    GATEWAY=$(ip route | awk -v i="$INTERFACE" '/default/{if($5==i){print $3; exit}}')
    GATEWAY=${GATEWAY:-$(ip route | awk '/default/{print $3; exit}')}

    MY_IP=$(ip -4 -o addr show dev "$INTERFACE" | awk '{print $4; exit}')
    if [ -z "$MY_IP" ]; then
        err "No IPv4 address on $INTERFACE."
        exit 1
    fi
    IPADDR="${MY_IP%/*}"
    PREFIX="${MY_IP#*/}"

    if [ -z "$CIDR" ]; then
        CIDR="$IPADDR/$PREFIX"
    fi

    ping -c 1 -W 1 "$GATEWAY" >/dev/null 2>&1
    GATEWAY_MAC=$(ip neigh show "$GATEWAY" 2>/dev/null | grep -oP 'lladdr \K[0-9a-f:]{17}' | head -1)
}

# -----------------------------------------------------------------------------
# Host list from CIDR (e.g. 192.168.1.0/24 -> 192.168.1.1..254)
# -----------------------------------------------------------------------------
ip2int() {
    local a b c d
    IFS=. read -r a b c d <<< "$1"
    echo "$(((a<<24) + (b<<16) + (c<<8) + d))"
}
int2ip() {
    local n=$1
    echo "$(( (n>>24)&255 )).$(( (n>>16)&255 )).$(( (n>>8)&255 )).$(( n&255 ))"
}
range_from_cidr() {
    local cidr=$1
    local addr=${cidr%/*} prefix=${cidr#*/}

    valid_ip4 "$addr" || { err "Invalid CIDR address: '$addr'"; return 1; }
    [[ "$prefix" =~ ^[0-9]+$ ]] || { err "Invalid CIDR prefix: '$prefix'"; return 1; }
    [ "$prefix" -le 32 ] || { err "CIDR prefix must be 0-32 (got $prefix)."; return 1; }
    if [ "$prefix" -le 15 ]; then
        err "Refusing a /${prefix} scan: too large (use a /16 or smaller subnet)."
        return 1
    fi

    local int net s e total
    int=$(ip2int "$addr")

    if [ "$prefix" -eq 32 ]; then
        s=$int; e=$int
    elif [ "$prefix" -eq 31 ]; then
        # point-to-point link: both addresses are usable
        net=$(( int & ~1 ))
        s=$net; e=$((net + 1))
    else
        local mask=$(( (0xFFFFFFFF << (32-prefix)) & 0xFFFFFFFF ))
        net=$(( int & mask ))
        s=$(( net + 1 ))
        e=$(( (net | (~mask & 0xFFFFFFFF)) - 1 ))
    fi

    total=$(( e - s + 1 ))
    if [ "$total" -gt 65534 ]; then
        e=$(( s + 65533 ))
        warn "Subnet has ${total} hosts; capping at first 65534 hosts."
    fi
    echo "$s $e"
}

# -----------------------------------------------------------------------------
# Name resolution: mDNS -> rDNS -> NetBIOS
# -----------------------------------------------------------------------------
resolve_device_name() {
    local ip=$1
    local name=""

    if command -v avahi-resolve-address &>/dev/null; then
        name=$(timeout 2 avahi-resolve-address "$ip" 2>/dev/null | awk '{print $2}' | head -1)
    fi
    if [ -z "$name" ]; then
        name=$(timeout 2 getent hosts "$ip" 2>/dev/null | awk '{print $2}' | head -1)
    fi
    if [ -z "$name" ] && command -v dig &>/dev/null; then
        name=$(timeout 2 dig +short -x "$ip" 2>/dev/null | head -1 | sed 's/\.$//')
    fi
    if [ -z "$name" ] && command -v host &>/dev/null; then
        name=$(timeout 2 host "$ip" 2>/dev/null | head -1 | awk '{print $NF}' | sed 's/\.$//')
    fi
    if [ -z "$name" ] && command -v nslookup &>/dev/null; then
        name=$(timeout 2 nslookup "$ip" 2>/dev/null | awk '/name =/{print $NF; exit}' | sed 's/\.$//')
    fi
    if [ -z "$name" ] && command -v nmblookup &>/dev/null; then
        name=$(timeout 2 nmblookup -A "$ip" 2>/dev/null | awk '$2=="<20>"{print $1; exit}')
        [ -z "$name" ] && name=$(timeout 2 nmblookup -A "$ip" 2>/dev/null | awk '$2=="<00>"{print $1; exit}')
    fi

    name=$(echo "$name" | sed 's/\.$//;s/\.local$//' | cut -c1-40)
    if [ -z "$name" ] || [ "$name" = "localhost" ] || [ "$name" = "$ip" ]; then
        echo "Unknown"
    else
        echo "$name"
    fi
}

