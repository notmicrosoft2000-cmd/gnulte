classify() {
    local vendor=$1 name=$2 gateway=$3
    local vt ntype
    if [ "$gateway" = true ]; then
        echo "Router (Gateway)"
        return
    fi
    vt=$(vendor_type "$vendor")
    if [ "$vt" != "Unknown" ] && [ "$vt" != "Router" ]; then
        echo "$vt"
        return
    fi
    ntype=$(name_type "$name")
    if [ "$ntype" != "Unknown" ]; then
        echo "$ntype"
    else
        echo "$vt"
    fi
}

# -----------------------------------------------------------------------------
# Deep per-host scan (open ports + OS) via nmap
# -----------------------------------------------------------------------------
deep_scan() {
    local ip=$1 ports="" os=""
    command -v nmap &>/dev/null || return 0
    # Single structured (-oG) run reused for BOTH ports and OS fingerprint.
    local out
    out=$(timeout 90 nmap -O -Pn --top-ports 100 -oG - "$ip" 2>/dev/null)
    ports=$(grep -oP '\b[0-9]+(?=/open/tcp/)' <<< "$out" | sort -un | tr '\n' ',' | sed 's/,$//')
    os=$(awk -F'OS: ' 'NF>1{print $2}' <<< "$out" | head -1 | cut -d'|' -f1 | sed -E 's/[[:space:]]*Seq:.*//')
    echo "$ports|$os"
}

# -----------------------------------------------------------------------------
# Ping sweep to populate the ARP/neighbor table
# -----------------------------------------------------------------------------
run_ping_sweep() {
    local start=$1 end=$2
    if command -v fping &>/dev/null; then
        fping -a -q -g "$(int2ip "$start")" "$(int2ip "$end")" >/dev/null 2>&1
        return
    fi
    local list="$TMP_DIR/hosts.txt"
    : > "$list"
    local i=$start
    while [ "$i" -le "$end" ]; do
        echo "$(int2ip "$i")"
        i=$((i+1))
    done > "$list"
    xargs -P "$THREADS" -n 1 -I{} sh -c 'ping -c1 -W1 "$1" >/dev/null 2>&1' _ {} < "$list" >/dev/null 2>&1
    rm -f "$list"
}

# Map MAC -> vendor (arp-scan needs root; its OUI database file does not)
load_vendors() {
    local oui_files=("/usr/share/arp-scan/ieee-oui.txt" "/usr/share/ieee-data/oui.txt" "/usr/share/arp-scan/ieee-oui.iab")

    if command -v arp-scan &>/dev/null && [ "$(id -u)" -eq 0 ]; then
        while IFS='|' read -r mac vendor; do
            [ -n "$mac" ] && VENDOR_MAP["${mac,,}"]="$vendor"
        done < <(arp-scan --local 2>/dev/null \
            | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+/{mac=$2; $1=""; $2=""; sub(/^[ \t]+/,""); sub(/[ \t]+$/,""); print mac "|" $0}')
        return
    fi

    # Fallback: read the OUI database shipped with arp-scan (no root required)
    # Format per entry: <HEX-PREFIX-in-uppercase><TAB><Vendor> (any prefix length)
    local file line oui v
    for file in "${oui_files[@]}"; do
        [ -s "$file" ] || continue
        while IFS= read -r line; do
            case "$line" in
                ''|\#*) continue ;;
                *$'\t'*)
                    oui="${line%%	*}"
                    v="${line#*	}"
                    [ -n "$oui" ] && [ -n "$v" ] && VENDOR_MAP["$oui"]="${v%%$'\r'}"
                    ;;
            esac
        done < "$file"
        [ ${#VENDOR_MAP[@]} -gt 0 ] && break
    done

    if [ ${#VENDOR_MAP[@]} -eq 0 ] && ! command -v arp-scan &>/dev/null; then
        warn "arp-scan not found — vendor column will be Unknown. Install arp-scan for OUI data."
    elif [ ${#VENDOR_MAP[@]} -eq 0 ]; then
        warn "No OUI database found (looked for arp-scan ieee-oui.txt). Run as root for arp-scan vendor data."
    fi
}

# Longest-prefix OUI lookup: try 12,10,8,6,4,2 hex chars like arp-scan does
mac_vendor() {
    local raw="${1//:/}"
    local pref len m
    for ((len=12; len>=2; len-=2)); do
        m="${raw:0:len}"
        m="${m^^}"
        [ -n "${VENDOR_MAP[$m]:-}" ] && { echo "${VENDOR_MAP[$m]}"; return 0; }
    done
    echo ""
    return 1
}

# -----------------------------------------------------------------------------
# Output
# -----------------------------------------------------------------------------
emit_table() {
    local ip mac vendor hostname type ports os n=0
    log ""
    log "${C_BOLD}Found ${#ROWS[@]} device(s) on $CIDR${C_RESET}"
    log ""
    printf "  %-3s %-16s %-20s %-18s %-22s %s\n" "#" "IP" "MAC" "Vendor" "Likely Type" "Hostname"
    echo "  ────────────────────────────────────────────────────────────────────────────"
    for row in "${ROWS[@]}"; do
        n=$((n+1))
        IFS='|' read -r ip mac vendor hostname type ports os <<< "$row"
        printf "  ${C_CYAN}%-3s${C_RESET} ${C_GREEN}%-16s${C_RESET} %-20s %-18s %-22s %s\n" \
            "$n" "$ip" "$mac" "${vendor:0:18}" "${type:0:22}" "${hostname:0:30}"
        [ -n "$ports" ] && printf "    ${C_DIM}ports: %s${C_RESET}\n" "$ports"
        if [ -n "$os" ]; then
            printf "    ${C_DIM}os:    %s${C_RESET}\n" "$os"
        elif [ "$DEEP" = true ]; then
            printf "    ${C_DIM}os:    (no answer from active fingerprint)${C_RESET}\n"
        fi
    done
    log ""
    log "${C_DIM}* 'Likely Type' is estimated from OUI vendor + hostname.${C_RESET}"
    if [ "$DEEP" = true ]; then
        log "${C_MAGENTA}* Deep mode = active recon: nmap port/OS probes were sent to each host.${C_RESET}"
    fi
    log ""
}

# RFC-4180-style field escaping (quotes doubled), safe for commas/newlines.
cesc() { printf '%s' "$1" | sed 's/"/""/g'; }

emit_csv() {
    echo "ip,mac,vendor,hostname,type,ports,os"
    local ip mac vendor hostname type ports os
    for row in "${ROWS[@]}"; do
        IFS='|' read -r ip mac vendor hostname type ports os <<< "$row"
        printf '"%s","%s","%s","%s","%s","%s","%s"\n' \
            "$(cesc "$ip")" "$(cesc "$mac")" "$(cesc "$vendor")" \
            "$(cesc "$hostname")" "$(cesc "$type")" "$(cesc "$ports")" "$(cesc "$os")"
    done
}

# YAML-safe single-quoted scalars.
yesc() { printf "'%s'" "${1//\'/\'\'}"; }

emit_yaml() {
    echo "subnet: ${CIDR}"
    echo "device_count: ${#ROWS[@]}"
    if [ "$DEEP" = true ]; then
        echo "deep: true   # active recon (nmap probes were sent)"
    fi
    echo "devices:"
    local ip mac vendor hostname type ports os
    for row in "${ROWS[@]}"; do
        IFS='|' read -r ip mac vendor hostname type ports os <<< "$row"
        echo "  - ip: $(yesc "$ip")"
        echo "    mac: $(yesc "$mac")"
        echo "    vendor: $(yesc "$vendor")"
        echo "    hostname: $(yesc "$hostname")"
        echo "    likely_type: $(yesc "$type")"
        echo "    ports: $(yesc "$ports")"
        echo "    os: $(yesc "$os")"
    done
}

emit_json() {
    local ip mac vendor hostname type ports os
    if command -v jq &>/dev/null; then
        local -a objs=()
        for row in "${ROWS[@]}"; do
            IFS='|' read -r ip mac vendor hostname type ports os <<< "$row"
            objs+=("$(jq -cn \
                --arg ip "$ip" --arg mac "$mac" --arg vendor "$vendor" \
                --arg hostname "$hostname" --arg type "$type" \
                --arg ports "$ports" --arg os "$os" \
                '{ip:$ip,mac:$mac,vendor:$vendor,hostname:$hostname,likely_type:$type,ports:$ports,os:$os}')")
        done
        jq -n --arg cidr "$CIDR" \
            --argjson devices "$(printf '%s\n' "${objs[@]}" | jq -s .)" \
            '{cidr:$cidr, device_count:($devices|length), devices:$devices}'
        return
    fi

    # No jq: manual, fully escaped fallback (same shape as the jq output)
    local first=true
    printf '{'
    printf '"cidr":%s,"device_count":%d,"devices":[' "$(jesc "$CIDR")" "${#ROWS[@]}"
    for row in "${ROWS[@]}"; do
        IFS='|' read -r ip mac vendor hostname type ports os <<< "$row"
        [ "$first" = false ] && printf ","
        first=false
        printf '{"ip":%s,"mac":%s,"vendor":%s,"hostname":%s,"likely_type":%s,"ports":%s,"os":%s}' \
            "$(jesc "$ip")" "$(jesc "$mac")" "$(jesc "$vendor")" "$(jesc "$hostname")" \
            "$(jesc "$type")" "$(jesc "$ports")" "$(jesc "$os")"
    done
    printf ']}'
    echo ""
}

jesc() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g;s/"/\\"/g;s/\t/\\t/g;s/\r//g')"; }

# -----------------------------------------------------------------------------
# Main
# -----------------------------------------------------------------------------
I_AM_ROOT=false
[ "$(id -u)" -eq 0 ] && I_AM_ROOT=true

TMP_DIR="$(mktemp -d /tmp/gnulte-scan.XXXXXX 2>/dev/null)" || { err "Could not create temp dir."; exit 1; }
trap 'rm -rf "$TMP_DIR" 2>/dev/null' EXIT

while [ $# -gt 0 ]; do
    case "$1" in
        -i|--interface) INTERFACE="$2"; shift 2 ;;
        -C|--cidr) CIDR="$2"; shift 2 ;;
        -t|--threads)
            THREADS="$2"; shift 2
            [[ "$THREADS" =~ ^[0-9]+$ ]] || { err "--threads must be a positive integer (got '$THREADS')."; exit 1; }
            [ "$THREADS" -ge 1 ] && [ "$THREADS" -le 512 ] || { err "--threads must be between 1 and 512."; exit 1; }
            ;;
        -d|--deep) DEEP=true; shift ;;
        -j|--json) OUT_FORMAT="json"; shift ;;
        -y|--yaml) OUT_FORMAT="yaml"; shift ;;
        -c|--csv) OUT_FORMAT="csv"; shift ;;
        -q|--quiet) QUIET=true; shift ;;
        -h|--help) usage ;;
        --version) echo "$MY_NAME $VERSION"; exit 0 ;;
        *) err "Unknown option: $1"; usage ;;
    esac
done

scan_check_acceptance

# Re-raise privileges message for deep active recon
if [ "$DEEP" = true ] && [ "$((EUID))" -ne 0 ]; then
    warn "Deep scan uses nmap; running as root improves OS detection (sudo ${MY_NAME} ...)."
fi

detect_network

if [ "$QUIET" = false ]; then
    log ""
    log "${C_BOLD}${MY_NAME} ${VERSION}${C_RESET} — LAN device discovery & fingerprinting"
    log "  Interface : ${C_CYAN}$INTERFACE${C_RESET}"
    log "  Subnet    : ${C_CYAN}$CIDR${C_RESET}"
    if [ "$DEEP" = true ]; then
        log "  Deep scan : ${C_MAGENTA}enabled — ACTIVE recon (nmap ports + OS fingerprints)${C_RESET}"
    fi
    log "  Gateway   : ${C_CYAN}$GATEWAY${C_RESET} ${GATEWAY_MAC:+($GATEWAY_MAC)}"
    log "  Your IP   : ${C_CYAN}$IPADDR${C_RESET}"
    log ""
    log "${C_BOLD}> DISCLAIMER:${C_RESET} scan only networks you own or are authorized to test."
    log "${C_BOLD}> "Type" is a LIKELY guess from OUI vendor + hostname, not a guarantee.${C_RESET}"
    log ""
fi

# --- discovery ---
ROWS=()
USE_ARP_SOURCE=false

if [ "$I_AM_ROOT" = true ] && command -v arp-scan &>/dev/null; then
    if [ "$QUIET" = false ]; then
        log "  ${C_YELLOW}Discovering via arp-scan (ARP, tolerates ICMP-blocking subnets)...${C_RESET}"
    fi
    arp_primary &
    dpid=$!
    spinner "$dpid" "ARP discovery..."
    wait "$dpid"
    [ ${#ROWS[@]} -gt 0 ] && USE_ARP_SOURCE=true
fi

if [ "$USE_ARP_SOURCE" = false ]; then
    RANGE_OUT=$(range_from_cidr "$CIDR") || exit 1
    read -r START END <<< "$RANGE_OUT"
    TOTAL=$(( END - START + 1 ))
    if [ "$QUIET" = false ]; then
        log "  ${C_YELLOW}Pinging ${TOTAL} host(s) to populate the ARP table...${C_RESET}"
    fi
    run_ping_sweep "$START" "$END" &
    sweep_pid=$!
    spinner "$sweep_pid" "Ping sweep..."
    wait "$sweep_pid"
    load_vendors
    neighbor_fallback
fi

if [ "$QUIET" = false ]; then
    log "  ${C_YELLOW}Resolving device details...${C_RESET}"
fi

# --- enrich: hostname, gateway tag, likely type, optional deep (active) recon ---
ROW2=()
for row in "${ROWS[@]}"; do
    IFS='|' read -r rec_ip rec_mac vendor _ign <<< "$row"
    [ -n "$rec_ip" ] && [ -n "$rec_mac" ] || continue
    hostname=$(resolve_device_name "$rec_ip")
    is_gateway=false
    if [ "$rec_ip" = "$GATEWAY" ] || { [ -n "$GATEWAY_MAC" ] && [ "${rec_mac,,}" = "${GATEWAY_MAC,,}" ]; }; then
        is_gateway=true
    fi
    dev_type=$(classify "$vendor" "$hostname" "$is_gateway")
    ports=""
    os=""
    if [ "$DEEP" = true ]; then
        p_o=$(deep_scan "$rec_ip")
        ports="${p_o%%|*}"
        os="${p_o##*|}"
        [ "$ports" = "None" ] && [ "$os" = "Unknown" ] && os="(active scan: no answer)"
    fi
    ROW2+=("$rec_ip|$rec_mac|$vendor|$hostname|$dev_type|$ports|$os")
done
ROWS=("${ROW2[@]}")

if [ ${#ROWS[@]} -eq 0 ]; then
    err "Scanned ${TOTAL:-0} host(s): no responses observed."
    err "Try: sudo ${MY_NAME} (ARP discovery), or install fping/arp-scan — many networks block ICMP ping."
    exit 1
fi

case "$OUT_FORMAT" in
    json) emit_json ;;
    yaml) emit_yaml ;;
    csv)  emit_csv ;;
    *)    emit_table ;;
esac