# Load custom profiles (plain data file, never sourced — no code execution)
load_custom_profiles() {
    CUSTOM_PROFILES=()
    [ -f "$PROFILES_FILE" ] || return 0
    local line name val
    while IFS= read -r line; do
        case "$line" in
            ''|\#*) continue ;;
        esac
        if [[ "$line" =~ ^[A-Za-z0-9_.-]+=[0-9]+\|[0-9]+\|[0-9]+\|[0-9]+\|[0-9]+\|[0-9]+$ ]]; then
            name="${line%%=*}"; val="${line#*=}"
            CUSTOM_PROFILES["$name"]="$val"
        fi
    done < "$PROFILES_FILE"
}
load_custom_profiles

