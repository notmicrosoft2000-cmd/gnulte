display_devices() {
    echo -e "${COLOR_BOLD}Device List:${COLOR_RESET}"
    if [ "$QUICK_SCAN" = true ]; then
        echo -e "${COLOR_DIM}  #  IP Address        Hostname         Type         Vendor${COLOR_RESET}"
        echo "  ──────────────────────────────────────────────────────────────────────"
        for i in "${!IP_LIST[@]}"; do
            HOST_DISPLAY="${HOSTNAME_LIST[$i]:0:16}"
