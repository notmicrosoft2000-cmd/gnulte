# -----------------------------------------------------------------------------
# SUDO CHECK (at startup)
# -----------------------------------------------------------------------------
check_sudo() {
    if [ "$EUID" -ne 0 ]; then
        echo -e "${COLOR_WARN}"
        echo "════════════════════════════════════════════════════════════════════════════"
        echo "  ADMINISTRATOR PRIVILEGES REQUIRED"
        echo "════════════════════════════════════════════════════════════════════════════"
        echo -e "${COLOR_RESET}"
        echo "GNULTE requires sudo (root) access for the following reasons:"
        echo ""
        echo "  • arp-scan      – needs raw socket access to scan the network"
        echo "  • arpspoof      – needs raw socket access to send ARP packets"
        echo "  • tc (traffic)  – needs kernel-level access to modify packet flow"
        echo "  • sysctl        – needs to enable IP forwarding for MITM operation"
        echo ""
        echo "Without sudo, these tools cannot function. GNULTE will now request"
        echo "your password to continue."
        echo ""
        echo -e "${COLOR_WARN}════════════════════════════════════════════════════════════════════════════${COLOR_RESET}"
        echo ""
        
        # Re-execute script with sudo
        sudo -v || { echo -e "${COLOR_ERR}Failed to obtain sudo. Exiting.${COLOR_RESET}"; exit 1; }
        
        # Keep sudo alive in background (track it so cleanup can stop it)
        ( while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null ) &
        SUDO_PING_PID=$!
        
        echo -e "${COLOR_OK}[OK] Sudo access granted.${COLOR_RESET}"
        echo ""
    fi
}

# -----------------------------------------------------------------------------
# LEGAL / SAFETY FIRST-RUN GATE
# -----------------------------------------------------------------------------
# The GPL (LICENSE) covers copyright. Safety, disclaimer, authorization and
# network-testing policy are separate documents. On first run (or whenever the
# versioned safety documents change) the operator must review and acknowledge
# each one before any network-impacting feature can run. The acceptance file is
# treated as DATA — it is never eval'd or sourced, and no flag bypasses this
# gate.

safety_docs() {
    echo "LICENSE
SAFETY.md
DISCLAIMER.md
AUTHORIZED-USE.md
NETWORK-TESTING.md"
}

# Locate the installed docs; falls back to the script's own directory (git
# checkout) and the standard share installation locations.
find_safety_doc() {
    local name="$1" d f=""
    for d in "$GNULTE_DOC_DIR" "$SCRIPT_DIR" /usr/local/share/doc/gnulte /usr/share/doc/gnulte; do
        [ -n "$d" ] || continue
        f="$d/$name"
        [ -f "$f" ] && { echo "$f"; return 0; }
    done
    return 1
}

# Embedded fallback text when the markdown documents are not installed.
embedded_doc() {
    case "$1" in
        LICENSE)
            echo "LICENSE — GNU GPL version 3 or later."
            echo "See the LICENSE file in the GNULTE repository for the full"
            echo "official text. It covers redistribution and modification only;"
            echo "it grants no permission to test, intercept, or disrupt any network." ;;
        SAFETY.md)
            echo "SAFETY.md — GNULTE can perform ARP-based man-in-the-middle"
            echo "operation, traffic manipulation, impairment, and packet capture."
            echo "GNULTE-SCAN can perform LAN discovery and active reconnaissance."
            echo "Use these only on networks/devices you own or are explicitly"
            echo "authorized to test. Capture and impairment can affect others." ;;
        DISCLAIMER.md)
            echo "DISCLAIMER.md — Provided 'AS IS', without warranty, to the"
            echo "maximum extent permitted by law. Users are solely responsible"
            echo "for authorization and compliance. This does not modify or"
            echo "supersede the GPL." ;;
        AUTHORIZED-USE.md)
            echo "AUTHORIZED-USE.md — Record who authorized the test, which"
            echo "systems/IPs are in scope or excluded, which techniques are"
            echo "allowed, capture/disruption permission, the testing window,"
            echo "and an emergency contact before you begin." ;;
        NETWORK-TESTING.md)
            echo "NETWORK-TESTING.md — Controlled testing chain: GNULTE-SCAN"
            echo "discovers targets, GNULTE reproduces latency/jitter/loss/"
            echo "duplication/reorder/bandwidth conditions against authorized"
            echo "targets so applications can be observed under bad networks." ;;
    esac
}

# Render a markdown doc to the terminal: headings emphasized, code fences
# removed, bullets/blockquotes indented, inline bold/backticks stripped.
render_doc_text() {
    local line
    while IFS= read -r line; do
        line="${line//\*\*/}"; line="${line//\`/}"
        case "$line" in
            '```'*|'~~~'*) printf "\n${COLOR_DIM}────────────────────────────────${COLOR_RESET}\n" ;;
            '### '*|'## '*|'# '*) printf "\n${COLOR_BOLD}${COLOR_HEADER}%s${COLOR_RESET}\n" "${line#[#]}" ;;
            '---'*) printf "${COLOR_DIM}────────────────────────────────${COLOR_RESET}\n" ;;
            '>'*) printf "  ${COLOR_DIM}%s${COLOR_RESET}\n" "${line#\> }" ;;
            '-'*|'*'*) printf "    %s\n" "$line" ;;
            '') printf "\n" ;;
            *) printf "%s\n" "$line" ;;
        esac
    done
}

read_doc() {
    local name="$1" f
    f="$(find_safety_doc "$name")"
    if [ -n "$f" ]; then
        render_doc_text < "$f"
    else
        embedded_doc "$name"
    fi
}

# Show a document with restart/quit options, then require an explicit per-doc
# acknowledgment. We do NOT claim the user "read" anything — only that the
# document was shown and the requirement acknowledged.
review_doc() {
    local name="$1" idx="$2" total="$3" choice

    while : ; do
        echo ""
        echo -e "${COLOR_BOLD}◆ Document [${idx}/${total}]: $name${COLOR_RESET}"
        echo "  Opening document [${idx}/${total}]..."
        echo ""
        read_doc "$name"
        echo ""
        echo "  [O] Open in editor      [R] Restart document"
        echo "  [Q] Quit                [C] Continue to acknowledgment"
        read -p "  Choice: " choice
        case "${choice^^}" in
            O)  if [ -t 0 ] && command -v nano &>/dev/null; then
                    f="$(find_safety_doc "$name")"; [ -n "$f" ] && nano "$f"
                else
                    echo -e "${COLOR_DIM}    (no editor/interactive terminal available; scroll up to review)${COLOR_RESET}"
                fi
                continue ;;
            R) continue ;;
            Q) echo -e "${COLOR_ERR}Review stopped. GNULTE will not proceed without acknowledgment.${COLOR_RESET}"; exit 1 ;;
            C) break ;;
            *) echo -e "${COLOR_DIM}    Please choose O, R, Q or C.${COLOR_RESET}" ;;
        esac
    done

    local ack=""
    while : ; do
        echo ""
        read -p "  I have reviewed this document. [y/N]: " ack
        case "$ack" in
            y|Y) return 0 ;;
            n|N|"") echo -e "${COLOR_ERR}No acknowledgment recorded for ${name}. Exiting — nothing was shown past this point.${COLOR_RESET}"; exit 1 ;;
            *)   echo -e "${COLOR_DIM}    Please answer y or N.${COLOR_RESET}" ;;
        esac
    done
}

# Write the shared acceptance record (data only; never sourced/evalled).
write_acceptance() {
    mkdir -p "$GNULTE_ACCEPTANCE_DIR" || { echo -e "${COLOR_ERR}Could not create $GNULTE_ACCEPTANCE_DIR.${COLOR_RESET}"; exit 1; }
    ( umask 077; printf 'SAFETY_POLICY_VERSION=%s\nSAFETY_ACKNOWLEDGED=1\nDISCLAIMER_ACKNOWLEDGED=1\nAUTHORIZATION_ACKNOWLEDGED=1\nNETWORK_TESTING_ACKNOWLEDGED=1\nTIMESTAMP=%s\n' \
        "$SAFETY_POLICY_VERSION" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$GNULTE_ACCEPTANCE_FILE" )
    echo ""
    echo -e "${COLOR_OK}You have been shown the required documents and acknowledged the"
    echo -e "safety and authorization requirements.${COLOR_RESET}"
    echo -e "${COLOR_DIM}This is an acknowledgment record — it cannot prove you read the"
    echo -e "documents, and it does not make any unauthorized activity lawful.${COLOR_RESET}"
    echo ""
    return 0
}

legal_onboarding() {
    local -a docs=()
    local i name cfm

    mapfile -t docs < <(safety_docs)

    echo ""
    echo -e "${COLOR_ERR}════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_BOLD}                     GNULTE FIRST RUN${COLOR_RESET}"
    echo -e "${COLOR_ERR}════════════════════════════════════════════════════════════════${COLOR_RESET}"
    echo ""
    read_doc FIRST-RUN-NOTICE.md
    echo ""
    echo -e "${COLOR_BOLD}WARNING${COLOR_RESET}"
    echo "  GNULTE is capable of ARP-based MITM operation, traffic"
    echo "  manipulation, packet capture, and network impairment."
    echo "  GNULTE-SCAN can perform active network discovery and"
    echo "  reconnaissance."
    echo ""
    echo "  These operations may affect other systems and users."
    echo "  You must have authorization before testing systems or"
    echo "  networks that you do not own."
    echo ""
    echo -e "  ${COLOR_BOLD}You are required to review the following documents:${COLOR_RESET}"
    for i in "${!docs[@]}"; do
        echo "    [$((i+1))] ${docs[$i]}"
    done
    echo ""
    echo -e "${COLOR_BOLD}  Shortcut: type  I AGREE  to skip the review and accept these documents.${COLOR_RESET}"
    read -p "  Type 'I AGREE' to accept these documents, or press Enter to review each one (Q quits): " cfm
    cfm="${cfm//[[:space:]]/}"
    case "${cfm^^}" in
        Q)   echo -e "${COLOR_ERR}Exiting. GNULTE will require this review on next launch.${COLOR_RESET}"; exit 1 ;;
        IAGREE) write_acceptance; return 0 ;;
    esac

    echo -e "${COLOR_DIM}  Nothing is recorded until all documents have been acknowledged.${COLOR_RESET}"
    echo ""
    for i in "${!docs[@]}"; do
        review_doc "${docs[$i]}" "$((i+1))" "${#docs[@]}"
    done

    write_acceptance
}

# Gate: if the current safety-policy version is not acknowledged, run onboarding.
check_acceptance() {
    local acked=""
    if [ -f "$GNULTE_ACCEPTANCE_FILE" ]; then
        acked="$(sed -n 's/^SAFETY_POLICY_VERSION=//p' "$GNULTE_ACCEPTANCE_FILE" 2>/dev/null | tail -1)"
    fi

    if [ "$acked" = "$SAFETY_POLICY_VERSION" ]; then
        return 0
    fi

    if [ -n "$acked" ]; then
        echo -e "${COLOR_WARN}Your GNULTE safety documents have changed.${COLOR_RESET}"
        echo -e "  Previous acknowledgment : version ${COLOR_TARGET}$acked${COLOR_RESET}"
        echo -e "  Current documents       : version ${COLOR_TARGET}$SAFETY_POLICY_VERSION${COLOR_RESET}"
        echo -e "${COLOR_BOLD}  Please review the updated documents before continuing.${COLOR_RESET}"
        echo ""
    fi

    if [ ! -t 0 ]; then
        echo -e "${COLOR_ERR}First-run safety acknowledgment must be completed from an"
        echo -e "interactive terminal. Start GNULTE there to review the required"
        echo -e "documents before any network-impacting operation.${COLOR_RESET}"
        exit 1
    fi

    legal_onboarding
}

# -----------------------------------------------------------------------------
# ANIMATIONS
# -----------------------------------------------------------------------------
spinner() {
    local pid=$1
    local msg="$2"
    local spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local colors=("${COLOR_ANIM}" "${COLOR_INFO}" "${COLOR_TARGET}")
    local i=0
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r${colors[$((i % 3))]}[%s]${COLOR_RESET} %s " "${spin[$((i % 10))]}" "$msg"
        i=$((i + 1))
        sleep 0.08
    done
    printf "\r${COLOR_OK}[✓]${COLOR_RESET} %s${COLOR_OK} ${COLOR_DIM}done${COLOR_RESET}    \n" "$msg"
}

progress_bar() {
    local current=$1
    local total=$2
    local width=40
    [ "$total" -le 0 ] && total=1
    local percent=$((current * 100 / total))
    local filled=$((current * width / total))
    local empty=$((width - filled))
    printf "\r  ${COLOR_DIM}[${COLOR_RESET}"
    printf "${COLOR_ANIM}"
    printf "%${filled}s" | tr ' ' '█'
    printf "${COLOR_RESET}${COLOR_DIM}"
    printf "%${empty}s" | tr ' ' '░'
    printf "${COLOR_DIM}]${COLOR_RESET} ${COLOR_BOLD}${percent}%%${COLOR_RESET} ${COLOR_DIM}(${current}/${total})${COLOR_RESET}"
}

# A real-time loading bar for a fixed number of seconds
animated_bar() {
    local secs=$1 msg="$2"
    local steps=$((secs * 10))
    [ "$steps" -lt 1 ] && steps=1
    for ((s=1; s<=steps; s++)); do
        progress_bar "$s" "$steps"
        printf "  %s" "$msg"
        sleep 0.1
    done
    printf "\n"
}

# Real startup initialisation: every line below is the result of an actual
# check that just ran. Nothing here is simulated and there are no artificial
# pauses — if a stage is not done, it is not reported as done.
real_boot() {
    local fail=0 forward
    printf "\n${COLOR_INFO}${COLOR_BOLD}  GNULTE v8.3 — Initialising${COLOR_RESET}\n"
    printf "  ${COLOR_DIM}Real checks only — nothing here is simulated or delayed.${COLOR_RESET}\n\n"

    printf "  ● Loading configuration...\n"
    if [ -f "$CONFIG_FILE" ]; then
        printf "  ${COLOR_OK}    loaded $CONFIG_FILE${COLOR_RESET}\n"
    else
        printf "  ${COLOR_WARN}    no config file — built-in defaults in use (run --settings to create one)${COLOR_RESET}\n"
    fi

    printf "  ● Calibrating network interfaces...\n"
    detect_network || fail=1

    printf "  ● Verifying utilities...\n"
    check_deps || fail=1

    printf "  ● Preparing traffic engine...\n"
    forward="$(sysctl -n net.ipv4.ip_forward 2>/dev/null || echo 0)"
    printf "  ${COLOR_DIM}    ip_forward=${forward} (GNULTE toggles it only during a test)${COLOR_RESET}\n"

    printf "\n"
    [ "$fail" -eq 0 ]
}

