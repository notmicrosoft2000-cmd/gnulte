    echo -e "${COLOR_DIM}  ─────────────────────────────────────────────────${COLOR_RESET}"
    echo -e "  ${COLOR_BOLD}${COLOR_HEADER}QUICK REFERENCE${COLOR_RESET}  ${COLOR_DIM}(full list: -h / --help)${COLOR_RESET}"
    echo "    GNULTE -t 192.168.1.20 --profile voip --duration 300"
