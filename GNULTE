# Apply COLOR_* assignments produced by theme_color_lines WITHOUT eval.
# Lines look like: COLOR_NAME="\033[1;36m"  ->  printf -v COLOR_NAME '%b' '\033[1;36m'
apply_lines() {
    local block="$1" line name val
    while IFS= read -r line; do
        case "$line" in
            COLOR_*=*)
                name="${line%%=*}"
                val="${line#*=}"
                val="${val%\"}"; val="${val#\"}"
                printf -v "$name" '%b' "$val"
                ;;
        esac
    done <<< "$block"
}

# Apply the selected theme (or "custom" if user hand-edited colors in the conf).
apply_theme() {
    [ -z "$THEME" ] && THEME="${DEFAULT_THEME:-classic}"
    if [ "$THEME" != "custom" ]; then
        apply_lines "$(theme_color_lines "$THEME")"
    fi
}

