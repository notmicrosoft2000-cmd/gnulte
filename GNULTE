    read -p "Latency (ms) [${LATENCY:-$DEFAULT_LATENCY}]: " LATENCY_INPUT
    [ -n "$LATENCY_INPUT" ] && LATENCY="$LATENCY_INPUT"
    LATENCY=${LATENCY:-$DEFAULT_LATENCY}

    echo ""
    echo -e "${COLOR_DIM}Jitter: Random variation in delay.${COLOR_RESET}"
