    echo ""
    echo -e "${COLOR_DIM}  ───────────────────────────────────────────────${COLOR_RESET}"
    echo -e "  ${COLOR_BOLD}${COLOR_HEADER}◆ $1${COLOR_RESET}"
    echo -e "${COLOR_DIM}  ───────────────────────────────────────────────${COLOR_RESET}"
}

