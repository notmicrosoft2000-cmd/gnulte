report_fname() {
    echo "$REPORT_SAMPLE_DIR/$(echo "$1" | tr './:' '_').txt"
}

ascii_chart_for() {
    local file=$1 label=$2
    local -a vals=()
    local v
    while IFS= read -r v; do vals+=("$v"); done < "$file"
    local n=${#vals[@]}
    [ "$n" -gt 0 ] || { echo "  (no samples recorded)"; return; }
    echo "  Latency over time – $label"

    local mx=0
    for v in "${vals[@]}"; do [ "$v" -gt "$mx" ] && mx=$v; done

    local cols=60 B=$n
    [ "$B" -gt "$cols" ] && B=$cols
    local step=$(( (n + B - 1) / B ))
    [ "$step" -lt 1 ] && step=1
    local -a buckets=() down=()
    local idx bstart bend sum_c bval down_b k
    for ((idx=0; idx<B; idx++)); do
        bstart=$((idx * step)); bend=$((bstart + step))
        [ "$bend" -gt "$n" ] && bend=$n
        sum_c=0; down_b=0
        for ((k=bstart; k<bend; k++)); do
            v="${vals[$k]}"
            if [ "$v" -lt 0 ]; then down_b=1; v=0; fi
            sum_c=$((sum_c + v))
        done
        bval=$((sum_c / (bend - bstart)))
        [ "$bval" -lt 1 ] && bval="$down_b"
        buckets[$idx]=$bval
        down[$idx]=$down_b
    done

    local gmax=$(( (mx + 99) / 100 * 100 ))
    [ "$gmax" -lt 100 ] && gmax=100
    local row yval ch bval2
    for ((row=5; row>=0; row--)); do
        yval=$((gmax * row / 5))
        if [ "$row" -eq 0 ]; then
            printf " %6d +" 0
            for ((idx=0; idx<B; idx++)); do printf "─"; done
            echo ""
        else
            printf " %6d │" "$yval"
            for ((idx=0; idx<B; idx++)); do
                bval2="${buckets[$idx]}"
                if [ "${down[$idx]}" -eq 1 ]; then ch="x"
                elif [ "$bval2" -ge "$yval" ]; then ch="█"
                elif [ "$bval2" -ge "$((yval * 3 / 4))" ]; then ch="▄"
                elif [ "$bval2" -ge "$((yval / 2))" ]; then ch="·"
                else ch=" "; fi
                printf "%s" "$ch"
            done
            echo ""
        fi
    done
    printf "           %s\n" "$label"
}

svg_chart_for() {
    local file=$1 label=$2 html=$3
    local -a vals=()
    local v
    while IFS= read -r v; do vals+=("$v"); done < "$file"
    local n=${#vals[@]}
    [ "$n" -gt 0 ] || return

    local mx=0
    for v in "${vals[@]}"; do [ "$v" -gt "$mx" ] && mx=$v; done
    [ "$mx" -lt 1 ] && mx=1

    local W=$((n * 4 + 60))
    [ "$W" -gt 900 ] && W=900
    [ "$W" -lt 220 ] && W=220
    local H=150 pad=25
    local span=$((H - pad - pad))
    [ "$span" -lt 1 ] && span=1

    {
        echo "<h2>Latency: $label</h2>"
        echo "<svg width=\"$W\" height=\"$H\" viewBox=\"0 0 $W $H\">"
        echo "<rect width=\"$W\" height=\"$H\" fill=\"#0d1117\"/>"
        echo "<line x1=\"$pad\" y1=\"$((H - pad))\" x2=\"$((W - 10))\" y2=\"$((H - pad))\" stroke=\"#30363d\"/>"
    } >> "$html"

    local pts="" idx x y cnt=0
    for ((idx=0; idx<n; idx++)); do
        v="${vals[$idx]}"
        x=$((pad + idx * 4))
        if [ "$v" -lt 0 ]; then
            echo "<circle cx=\"$x\" cy=\"$((H - pad))\" r=\"1.8\" fill=\"#f85149\"/>" >> "$html"
            continue
        fi
        y=$((pad + span - (v * span) / mx))
        pts="${pts}${x},${y} "
        cnt=$((cnt + 1))
    done
    [ "$cnt" -gt 1 ] && echo "<polyline points=\"$pts\" fill=\"none\" stroke=\"#39d1c4\" stroke-width=\"1.3\"/>" >> "$html"
    echo "</svg>" >> "$html"
}

generate_report() {
    if [ -z "$REPORT_SAMPLE_DIR" ] || [ ! -d "$REPORT_SAMPLE_DIR" ]; then
        return 0
    fi

    local outdir="gnulte-report-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$outdir" 2>/dev/null || return 0
    local txt="$outdir/report.txt"
    local html="$outdir/report.html"

    {
        echo "GNULTE v8.3 – Post-Test Report"
        echo "==============================="
        echo "Generated : $(date)"
        echo "Interface : $INTERFACE"
        echo "Gateway   : $GATEWAY"
        echo "Duration  : ${DURATION}s${RANDOM_MODE:+ (random mode active)}"
        [ "$BANDWIDTH" -gt 0 ] && echo "Bandwidth : ${BANDWIDTH} kbps"
        echo "Params    : latency ${LATENCY}ms | jitter ${JITTER}ms | loss ${LOSS}% | dup ${DUPLICATE}% | reorder ${REORDER}%"
        echo "Targets   : ${#TARGETS[@]} (${TARGETS[*]})"
        echo "Purpose   : Authorised network testing on owned/consented networks only"
        echo ""
    } > "$txt"

    cat > "$html" << 'EOF'
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>GNULTE Report</title>
<style>body{font-family:ui-monospace,Consolas,monospace;background:#0d1117;color:#c9d1d9;margin:2rem;max-width:900px}
h1{color:#39d1c4}h2{color:#58a6ff;border-bottom:1px solid #30363d;padding-bottom:.3rem;margin-top:1.8rem}
table{border-collapse:collapse;margin:1rem 0}td,th{border:1px solid #30363d;padding:.3rem .7rem;text-align:left}
th{color:#58a6ff}.p{color:#8b949e}</style></head>
<body><h1>GNULTE Report</h1>
<p class="p">Authorised network testing only. See application disclaimer.</p>
EOF

    echo "<h2>Summary</h2><table><tr><th>Target</th><th>Samples</th><th>Ok</th><th>Down</th><th>min</th><th>max</th><th>avg</th><th>loss %</th></tr>" >> "$html"

    local T file n cnt mn mx sum drops v avg loss att
    for T in "${TARGETS[@]}"; do
        file="$(report_fname "$T")"
        [ -f "$file" ] || continue

        n=$(wc -l < "$file")
        cnt=0; mn=999999; mx=0; sum=0; drops=0; v=0
        while IFS= read -r v; do
            if [ "$v" -lt 0 ]; then drops=$((drops + 1)); continue; fi
            cnt=$((cnt + 1)); sum=$((sum + v))
            [ "$v" -lt "$mn" ] && mn=$v
            [ "$v" -gt "$mx" ] && mx=$v
        done < "$file"
        avg=0; [ "$cnt" -gt 0 ] && avg=$((sum / cnt))
        loss="0.0"; att=$((cnt + drops)); [ "$att" -gt 0 ] && loss=$(awk -v d="$drops" -v a="$att" 'BEGIN{printf "%.1f", d*100/a}')
        [ "$cnt" -gt 0 ] || mn=0

        {
            echo ""
            echo "Target: $T"
            echo "  samples: $n   ok: $cnt   down: $drops"
            echo "  min: ${mn}ms   max: ${mx}ms   avg: ${avg}ms   loss: ${loss}%"
            echo ""
            ascii_chart_for "$file" "$T"
        } >> "$txt"

        echo "<tr><td>$T</td><td>$n</td><td>$cnt</td><td>$drops</td><td>${mn}ms</td><td>${mx}ms</td><td>${avg}ms</td><td>${loss}%</td></tr>" >> "$html"
        svg_chart_for "$file" "$T" "$html"
    done

    echo "</table>" >> "$html"
    echo "<p class='p'>Generated by GNULTE v8.3. Keep within authorised use.</p></body></html>" >> "$html"

    if [ -n "$EXPORT_CSV" ] && [ -f "$EXPORT_CSV" ]; then
        cp "$EXPORT_CSV" "$outdir/" 2>/dev/null
        echo "" >> "$txt"
        echo "CSV export copied into report directory." >> "$txt"
    fi

    if [ -d "$REPORT_SAMPLE_DIR" ]; then
        cp -r "$REPORT_SAMPLE_DIR" "$outdir/samples" 2>/dev/null
        echo "" >> "$txt"
        echo "Raw per-second samples stored in: samples/" >> "$txt"
    fi
    rm -rf "$REPORT_SAMPLE_DIR"
    REPORT_SAMPLE_DIR=""

    log_ok "Report saved to: ${COLOR_TARGET}$outdir/${COLOR_RESET} (txt + html + graphs)"
}

# -----------------------------------------------------------------------------
# MONITOR
# -----------------------------------------------------------------------------
monitor() {
    log_section "MONITORING"
    echo -e "${COLOR_DIM}Press ${COLOR_BOLD}Ctrl+C${COLOR_RESET}${COLOR_DIM} to stop${COLOR_RESET}"
    [ "$DURATION" -gt 0 ] && echo -e "${COLOR_DIM}Auto-stop in ${DURATION} seconds${COLOR_RESET}"
    [ "$RANDOM_MODE" = true ] && echo -e "${COLOR_WARN}Random mode active – parameters will vary${COLOR_RESET}"
    echo ""

    echo -e "  ${COLOR_BOLD}Targets:${COLOR_RESET} ${#TARGETS[@]} device(s)"
    echo -e "  ${COLOR_BOLD}Latency:${COLOR_RESET} ${LATENCY}ms  |  ${COLOR_BOLD}Jitter:${COLOR_RESET} ${JITTER}ms  |  ${COLOR_BOLD}Loss:${COLOR_RESET} ${LOSS}%"
    [ "$BANDWIDTH" -gt 0 ] && echo -e "  ${COLOR_BOLD}Bandwidth:${COLOR_RESET} ${BANDWIDTH} kbps"
    [ "$DURATION" -gt 0 ] && echo -e "  ${COLOR_BOLD}Duration:${COLOR_RESET} ${DURATION}s"
    echo -e "  ${COLOR_DIM}A post-test report (txt + html graphs) is generated on exit.${COLOR_RESET}"
    say "Now pinging each target once per second — the graph below updates live."
    echo ""
    log_info "Live ping: 1 sample/second per target (dashboard shows last/min/max/avg/loss)"

    # Multi-target: also spawn a terminal per target (optional eye-candy)
    if [ ${#TARGETS[@]} -gt 1 ]; then
        log_info "Multiple targets detected – spawning ${#TARGETS[@]} monitor windows..."
        for IP in "${TARGETS[@]}"; do
            if spawn_monitor_terminal "$IP" "$LATENCY" "$JITTER" "$LOSS" "$BANDWIDTH"; then
                log_ok "Monitor window spawned for $IP"
            else
                log_warn "Could not spawn monitor for $IP – the dashboard will track it"
            fi
        done
        echo ""
        log_info "Live dashboard tracks all targets – Ctrl+C stops everything."
        echo ""
    fi

    # Initialise per-target statistics
    local i
    for i in "${!TARGETS[@]}"; do
        STAT_COUNT[$i]=0; STAT_TOTAL[$i]=0; STAT_MIN[$i]=0; STAT_MAX[$i]=0
        STAT_DROP[$i]=0; STAT_LAST[$i]=-1
    done
    SPARK_SAMPLES=()

    START_TIME=$(date +%s)
    REPORT_SAMPLE_DIR=$(mktemp -d /tmp/gnulte-samples.XXXXXX 2>/dev/null) || REPORT_SAMPLE_DIR=""
    if [ -n "$REPORT_SAMPLE_DIR" ]; then
        for i in "${!TARGETS[@]}"; do
            : > "$(report_fname "${TARGETS[$i]}")"
        done
    fi

    if [ -n "$EXPORT_CSV" ]; then
        echo "Timestamp,Target,Latency_ms,Status" > "$EXPORT_CSV"
    fi

    trap 'dash_clear; echo ""; log_warn "Stopping..."; cleanup; exit 0' INT TERM

    if [ ${#TARGETS[@]} -eq 1 ]; then
        log_info "Console log style — each ping result appends a history line (Ctrl+C stops)."
        echo ""
    fi

    while true; do
        if [ "$DURATION" -gt 0 ]; then
            ELAPSED=$(($(date +%s) - START_TIME))
            if [ "$ELAPSED" -ge "$DURATION" ]; then
                dash_clear
                echo ""
                log_info "Duration limit reached (${DURATION}s). Stopping..."
                cleanup
                exit 0
            fi
        fi

        if [ "$RANDOM_MODE" = true ]; then
            RAND_LATENCY=$((LATENCY + RANDOM % 1000 - 500))
            [ "$RAND_LATENCY" -lt 100 ] && RAND_LATENCY=100
            RAND_JITTER=$((JITTER + RANDOM % 400 - 200))
            [ "$RAND_JITTER" -lt 50 ] && RAND_JITTER=50
            RAND_LOSS=$((RANDOM % 10))

            if [ "$BANDWIDTH" -gt 0 ]; then
                RATE="${BANDWIDTH}kbit"
            else
                RATE="1gbit"
            fi
            sudo tc class change dev "$INTERFACE" parent 1: classid 1:10 htb rate "$RATE" ceil "$RATE" 2>/dev/null
            sudo tc qdisc change dev "$INTERFACE" parent 1:10 handle 10: netem \
                delay "${RAND_LATENCY}ms" "${RAND_JITTER}ms" \
                ${RAND_LOSS:+loss ${RAND_LOSS}%} 2>/dev/null
        fi

        for i in "${!TARGETS[@]}"; do
            TARGET_IP="${TARGETS[$i]}"
            PING=$(ping -c 1 -W 1 "$TARGET_IP" 2>/dev/null | grep "time=" | awk -F'time=' '{print $2}' | cut -d' ' -f1)

            STAMP=$(date +%Y-%m-%d_%H:%M:%S)
            if [ -n "$PING" ]; then
                MS=$(printf "%.0f" "$PING")
                STAT_COUNT[$i]=$((STAT_COUNT[$i] + 1))
                STAT_TOTAL[$i]=$((STAT_TOTAL[$i] + MS))
                [ "${STAT_COUNT[$i]}" -eq 1 ] && STAT_MIN[$i]=$MS
                [ "$MS" -lt "${STAT_MIN[$i]}" ] && STAT_MIN[$i]=$MS
                [ "$MS" -gt "${STAT_MAX[$i]}" ] && STAT_MAX[$i]=$MS
                STAT_LAST[$i]=$MS

                if [ ${#TARGETS[@]} -eq 1 ]; then
                    SPARK_SAMPLES+=("$MS")
                    if [ ${#SPARK_SAMPLES[@]} -gt 60 ]; then
                        SPARK_SAMPLES=("${SPARK_SAMPLES[@]: -60}")
                    fi
                fi

                [ -n "$REPORT_SAMPLE_DIR" ] && echo "$MS" >> "$(report_fname "$TARGET_IP")"
                [ -n "$EXPORT_CSV" ] && echo "$STAMP,$TARGET_IP,$MS,OK" >> "$EXPORT_CSV"
            else
                STAT_DROP[$i]=$((STAT_DROP[$i] + 1))
                STAT_LAST[$i]=-1

                if [ ${#TARGETS[@]} -eq 1 ]; then
                    SPARK_SAMPLES+=("-1")
                    if [ ${#SPARK_SAMPLES[@]} -gt 60 ]; then
                        SPARK_SAMPLES=("${SPARK_SAMPLES[@]: -60}")
                    fi
                fi

                [ -n "$REPORT_SAMPLE_DIR" ] && echo "-1" >> "$(report_fname "$TARGET_IP")"
                [ -n "$EXPORT_CSV" ] && echo "$STAMP,$TARGET_IP,-1,DOWN" >> "$EXPORT_CSV"
            fi
        done

        # Spoof watchdog: if a spoof process died, restart both directions
        if [ "$STOPPING" != true ] && [ ${#SPOOF1_PIDS[@]} -gt 0 ]; then
            local i
            for i in "${!SPOOF1_PIDS[@]}"; do
                if ! alive_spoof "${SPOOF1_PIDS[$i]}" || ! alive_spoof "${SPOOF2_PIDS[$i]}"; then
                    log_warn "Spoof for ${TARGETS[$i]} died – restarting"
                    kill_own_spoof "${SPOOF1_PIDS[$i]}"
                    kill_own_spoof "${SPOOF2_PIDS[$i]}"
                    sleep 0.5
                    SPOOF1_PIDS[$i]="$(spoof_launch "$INTERFACE" "${TARGETS[$i]}" "$GATEWAY")"
                    sleep 0.5
                    SPOOF2_PIDS[$i]="$(spoof_launch "$INTERFACE" "$GATEWAY" "${TARGETS[$i]}")"
                    log_ok "Spoof restarted for ${TARGETS[$i]}"
                fi
            done
        fi

        if [ ${#TARGETS[@]} -eq 1 ]; then
            # Console output style: each ping gets its own permanent line (history).
            local ip0="${TARGETS[0]}" L="${STAT_LAST[0]}" try avg
            STAMP=$(date +%T)
            if [ "$L" -ge 0 ]; then
                local st="ok"
                [ "$L" -gt 300 ] && st="degraded"
                [ "$L" -gt 800 ] && st="severe"
                printf "  [%s] %-16s %5sms  %s\n" "$STAMP" "$ip0" "$L" "$st"
            else
                printf "  [%s] %-16s %7s  %s\n" "$STAMP" "$ip0" "DOWN" "unreachable"
            fi
            try=$((STAT_COUNT[0] + STAT_DROP[0]))
            if [ $((try % 10)) -eq 0 ] && [ "$try" -gt 0 ]; then
                avg=0; [ "${STAT_COUNT[0]}" -gt 0 ] && avg=$((STAT_TOTAL[0] / STAT_COUNT[0]))
                printf "  ${COLOR_DIM}    — summary: min=${STAT_MIN[0]}ms  max=${STAT_MAX[0]}ms  avg=${avg}ms  loss=%s%%  (n=%s)${COLOR_RESET}\n" \
                    "$(awk -v d="${STAT_DROP[0]}" -v a="$try" 'BEGIN{printf "%.1f", d*100/a}')" "$try"
            fi
            if [ "$SOUND" = true ]; then
                if [ "$L" -ge 0 ]; then ping_sound "$L" 1; else ping_sound 0 0; fi
            fi
        else
            # Range/multi attack: live-updating summary dashboard, refreshed each second.
            dash_clear
            render_multi_dashboard
        fi

        sleep 1
    done
}

# -----------------------------------------------------------------------------
# CLEANUP
# -----------------------------------------------------------------------------
# Restore the root qdisc that existed before we started shaping (best-effort).
restore_qdisc() {
    [ -n "$QDISC_BEFORE" ] || return 0
    local -a f=($QDISC_BEFORE)
    [ "${#f[@]}" -ge 3 ] || return 0
    local kind="${f[1]}"
    case "$kind" in
        none|noqueue|nomatch) return 0 ;;
    esac
    local handle="${f[2]%:}"
    # fields: qdisc <kind> <handle:> dev <name> root refcnt <n> [options...]
    local rest=() skip=false num=0
    for w in "${f[@]:3}"; do
        if $skip; then skip=false; continue; fi
        case "$w" in
            dev) continue ;;
            root) continue ;;
            refcnt) skip=true; continue ;;
        esac
        rest+=("$w")
    done
    log_cmd "tc qdisc add dev $INTERFACE root ${handle:+handle $handle }$kind ${rest[*]}"
    local -a add_cmd=(qdisc add dev "$INTERFACE" root)
    [ -n "$handle" ] && add_cmd+=(handle "$handle")
    add_cmd+=("$kind" "${rest[@]}")
    if sudo tc "${add_cmd[@]}" 2>/dev/null; then
        log_ok "Previous root qdisc restored ($kind)"
    else
        log_warn "Could not fully re-create previous root qdisc ($kind) — kernel default applied."
    fi
}

cleanup() {
    [ "$STOPPING" = true ] && return 0
    [ "$STATE_DIRTY" = false ] && { STOPPING=true; cleanup_tmp; return 0; }
    STOPPING=true
    echo ""
    say "Shutting things down and restoring the normal connection…"
    log_info "Cleaning up..."

    # Kill monitor terminals (only the ones we spawned)
    local PID
    for PID in "${TERMINAL_PIDS[@]}"; do
        kill "$PID" 2>/dev/null
    done

    # Stop ARP spoofing: only our own process groups, never other users'
    if [ ${#SPOOF1_PIDS[@]} -gt 0 ] || [ ${#SPOOF2_PIDS[@]} -gt 0 ]; then
        animated_bar 1 "Stopping ARP spoofing..."
        for PID in "${SPOOF1_PIDS[@]}" "${SPOOF2_PIDS[@]}"; do
            kill_own_spoof "$PID"
        done

        # Help the target forget our forged ARP entry (gratuitous ARP for gateway).
        if command -v arping &>/dev/null && [ -n "$GATEWAY" ]; then
            sudo arping -q -c 3 -U -I "$INTERFACE" "$GATEWAY" 2>/dev/null
            log_ok "Broadcast gateway ARP so targets re-learn the real router MAC"
        else
            log_info "arping not available — neighbors may take up to ~60s to refresh their ARP cache."
        fi
        log_ok "ARP spoofing stopped"
    fi

    # Restore traffic control (only if we actually built a shaping tree)
    if [ "$QDISCS_APPLIED" = true ]; then
        animated_bar 1 "Releasing traffic control..."
        log_cmd "tc qdisc del dev $INTERFACE root"
        sudo tc qdisc del dev "$INTERFACE" root 2>/dev/null
        log_ok "Traffic control removed"
        restore_qdisc
    fi

    # Restore IP forwarding to its original value
    if [ "$IP_FORWARD_CHANGED" = true ]; then
        log_cmd "sysctl -w net.ipv4.ip_forward=$ORIG_IP_FORWARD"
        sudo sysctl -w net.ipv4.ip_forward="$ORIG_IP_FORWARD" > /dev/null 2>&1
        log_ok "IP forwarding restored to $ORIG_IP_FORWARD"
    fi

    # Remove the per-target FORWARD DROP rules we installed in block mode
    if [ ${#IPTABLES_DROPS[@]} -gt 0 ]; then
        local IDR
        for IDR in "${IPTABLES_DROPS[@]}"; do
            log_cmd "iptables -D FORWARD $IDR"
            sudo iptables -D FORWARD $IDR 2>/dev/null
        done
        log_ok "FORWARD chain restore (${#IPTABLES_DROPS[@]} DROP rule(s) removed)"
        IPTABLES_DROPS=()
    fi

    if [ -n "$CAPTURE_PID" ]; then
        animated_bar 1 "Finishing packet capture..."
        sudo kill "$CAPTURE_PID" 2>/dev/null
        sleep 1
        if [ -n "$CAPTURE_FILE" ] && [ "$CAPTURE_FILE" != "-" ] && [ -f "$CAPTURE_FILE" ]; then
            sudo chown "$USER" "$CAPTURE_FILE" 2>/dev/null
            log_ok "Capture saved: $(du -h "$CAPTURE_FILE" 2>/dev/null | cut -f1) -> $CAPTURE_FILE"
        else
            log_ok "Capture stopped"
        fi
        CAPTURE_PID=""
    fi

    # Stop the sudo keep-alive helper we started at boot
    if [ -n "$SUDO_PING_PID" ]; then
        kill "$SUDO_PING_PID" 2>/dev/null
        SUDO_PING_PID=""
    fi

    if [ -n "$EXPORT_CSV" ]; then
        log_ok "Results exported to: $EXPORT_CSV"
    fi

    generate_report

    echo ""
    log_ok "Cleanup complete. Targets restored (ARP cache refresh may take a few seconds)."
}

# -----------------------------------------------------------------------------
# DEPENDENCY CHECK
# -----------------------------------------------------------------------------
check_deps() {
    local missing=()
    for cmd in arpspoof tc sysctl ping ip arp-scan; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done
    if [ -n "$CAPTURE_FILE" ] && ! command -v tcpdump >/dev/null 2>&1; then
        missing+=("tcpdump")
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        log_err "Missing dependencies: ${missing[*]}"
        echo ""
        echo "  Install with:"
        echo "    Debian/Ubuntu: sudo apt install dsniff iproute2 arp-scan"
        echo "    Arch:         sudo pacman -S dsniff iproute2 arp-scan"
        echo "    Fedora:       sudo dnf install dsniff iproute2 arp-scan"
        exit 1
    fi
}

verify_targets_reachable() {
    local ip fail=false rtt
    say "Checking each target is reachable before starting the attack…"
    for ip in "${TARGETS[@]}"; do
        if rtt=$(ping -c 1 -W 1 "$ip" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p') && valid_ip4 "$ip"; then
            rtt=${rtt%%.*}; rtt=${rtt:-0}
            ping_sound "$rtt" 1
            log_ok "Target $ip is reachable (${rtt}ms)"
        else
            ping_sound 0 0
            log_warn "Target $ip did not respond to a quick ping"
            fail=true
        fi
    done
    if [ "$fail" = true ]; then
        log_warn "Some targets may be offline or blocking ICMP — spoofing them may still work."
        if [ "$FORCE_MODE" != true ]; then
            read -p "  Continue anyway? (y/n) [y]: " ans
            case "${ans:-y}" in
                n|N) exit 0 ;;
            esac
        fi
    fi
}

# -----------------------------------------------------------------------------
# DUPLICATE IP / ARP CONFLICT DETECTOR
# -----------------------------------------------------------------------------
check_duplicate_ips() {
    log_section "DUPLICATE IP DETECTION"
    say "Checking for two devices quietly claiming the same IP address…"
    echo -e "${COLOR_DIM}Scans with arp-scan and flags any IP answered by more than one MAC.${COLOR_RESET}"
    echo ""

    if ! command -v arp-scan >/dev/null 2>&1; then
        log_err "arp-scan not found. Install with: sudo apt install arp-scan (Debian) / sudo pacman -S arp-scan (Arch)"
        exit 1
    fi

    local out="$TMP_DIR/dup.txt"
    ( sudo arp-scan --local > "$out" 2>/dev/null ) &
    local scan_pid=$!
    spinner "$scan_pid" "Scanning network for duplicate IPs..."
    wait "$scan_pid"

    local -A ip_macs=()
    local -a conflicts=()
    local line ip mac
    while IFS= read -r line; do
        ip=$(echo "$line"   | awk '{print $1}')
        mac=$(echo "$line"  | awk '{print $2}')
        valid_ip4 "$ip" || continue
        valid_mac "$mac" || continue
        if [ -n "${ip_macs[$ip]:-}" ] && [ "${ip_macs[$ip]}" != "$mac" ]; then
            conflicts+=("$ip")
            log_warn "DUPLICATE IP: $ip is claimed by BOTH"
            log_warn "    ${ip_macs[$ip]}  and  $mac"
            log_warn "    Two devices share one address — pings and ARP answers will be unreliable."
        else
            ip_macs[$ip]="$mac"
        fi
    done < "$out"
    rm -f "$out"

    echo ""
    if [ ${#conflicts[@]} -eq 0 ]; then
        log_ok "No duplicate IPs found (every address answered by exactly one MAC)."
    else
        local -a unique=($(printf '%s\n' "${conflicts[@]}" | sort -u))
        log_err "Found ${#unique[@]} IP conflict(s)."
        log_info "Cause is usually two devices fighting over one address (broken DHCP lease)."
        log_info "Resolve the conflict before running degradation tests so results are trustworthy."
    fi
    echo ""
}

