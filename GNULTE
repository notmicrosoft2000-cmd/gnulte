# -----------------------------------------------------------------------------
# PING SOUNDS (optional, enabled with --sound)
# -----------------------------------------------------------------------------
# Plays a short tone for each ping result: faster replies sound higher,
# slower replies lower, and a missing reply gets a distinct low buzz.
AUDIO_WAV="$TMP_DIR/gnulte-beep.wav"

gnulte_beep() {
    [ "$SOUND" = true ] || return 0
    local freq="$1" dur="$2"
    if [ -z "$AUDIO_PLAYER" ] || [ -z "$AUDIO_WAV" ]; then
        printf '\a' 2>/dev/null
        return 0
    fi
    # One shared wav file, rewritten per beep (16-bit mono 44.1kHz sine).
    awk -v f="$freq" -v d="$dur" -v r=44100 'BEGIN{
        n=int(r*d); total=36+n*2;
        printf "RIFF%c%c%c%c", total%256, int(total/256)%256, int(total/65536)%256, int(total/16777216)%256;
        printf "WAVEfmt %c%c%c%c", 16,0,0,0;
        printf "%c%c%c%c", 1,0,0,0;
        printf "%c%c%c%c", 1,0,0,0;
        printf "%c%c%c%c", 68,172,0,0;
        printf "%c%c%c%c", 136,88,1,0;
        printf "%c%c%c%c", 2,0,16,0;
        printf "data%c%c%c%c", (n*2)%256, int(n*2/256)%256, int(n*2/65536)%256, int(n*2/16777216)%256;
        for(i=0;i<n;i++){ v=int(127*sin(6.28318530718*f*i/r))*256; if(v<0) v+=65536; printf "%c%c", v%256, int(v/256)%256 }
    }' > "$AUDIO_WAV" 2>/dev/null
    case "$AUDIO_PLAYER" in
        *aplay) aplay -q "$AUDIO_WAV" >/dev/null 2>&1 &
            ;;
        *play) play -q "$AUDIO_WAV" >/dev/null 2>&1 &
            ;;
        *paplay) paplay "$AUDIO_WAV" >/dev/null 2>&1 &
            ;;
    esac
    return 0
}

# Sound for one ping outcome. rtt is the round-trip time in milliseconds
# (0 for no reply). Faster replies are higher pitched.
ping_sound() {
    local rtt="$1" ok="$2" freq
    if [ "$ok" = 1 ]; then
        freq=$(( 1200 - (rtt / 2) ))
        [ "$freq" -lt 300 ] && freq=300
        gnulte_beep "$freq" 0.1
    else
        gnulte_beep 196 0.3
    fi
}

