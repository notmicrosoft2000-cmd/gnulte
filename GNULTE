# -----------------------------------------------------------------------------
# ANIMATIONS
# -----------------------------------------------------------------------------
spinner() {
    local pid=$1
    local msg="$2"
    local spin=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
    local colors=("${COLOR_ANIM}" "${COLOR_INFO}" "${COLOR_TARGET}")
    local i=0
    while kill -0 "$pid" 2>/dev/null; do
        printf "\r${colors[$((i % 3))]}[%s]${COLOR_RESET} %s " "${spin[$((i % 10))]}" "$msg"
        i=$((i + 1))
        sleep 0.08
    done
    printf "\r${COLOR_OK}[✓]${COLOR_RESET} %s${COLOR_OK} ${COLOR_DIM}done${COLOR_RESET}    \n" "$msg"
}

progress_bar() {
    local current=$1
    local total=$2
    local width=40
    [ "$total" -le 0 ] && total=1
    local percent=$((current * 100 / total))
    local filled=$((current * width / total))
    local empty=$((width - filled))
    printf "\r  ${COLOR_DIM}[${COLOR_RESET}"
    printf "${COLOR_ANIM}"
    printf "%${filled}s" | tr ' ' '█'
    printf "${COLOR_RESET}${COLOR_DIM}"
    printf "%${empty}s" | tr ' ' '░'
    printf "${COLOR_DIM}]${COLOR_RESET} ${COLOR_BOLD}${percent}%%${COLOR_RESET} ${COLOR_DIM}(${current}/${total})${COLOR_RESET}"
}

flash() {
    for i in 1 2 3; do
        printf "\r${COLOR_WARN}▸ $1"
        sleep 0.2
        printf "\r${COLOR_INFO}▸ $1"
        sleep 0.2
    done
    printf "\r${COLOR_OK}[✓]${COLOR_RESET} $1${COLOR_RESET}    \n"
}

# Animated staged boot sequence shown while initialising
show_boot() {
    local -a stages=(
        "Initialising modules"
        "Loading configuration"
        "Calibrating network interfaces"
        "Preparing traffic engine"
        "Verifying utilities"
        "Starting"
    )
    local -a icons=("●" "▲" "■" "◆" "★" "▶")
    printf "\n${COLOR_INFO}${COLOR_BOLD}  GNULTE-BIOS v8.0${COLOR_RESET}\n"
    for idx in "${!stages[@]}"; do
        printf "\r  ${COLOR_DIM}${icons[$idx]}${COLOR_RESET} ${stages[$idx]}..."
        sleep 1
        printf "\r  ${COLOR_OK}${icons[$idx]}${COLOR_RESET} ${stages[$idx]}${COLOR_DIM} [ OK ]${COLOR_RESET}   \n"
        sleep 0.45
    done
    printf "\n"
}

# Blinking-ready style pulse line
pulse_line() {
    local text="$1"
    local color="$2"
    for _ in 1 2 3 4; do
        printf "\r${color}${COLOR_BOLD}$text"
        sleep 0.12
        printf "\r${COLOR_DIM}${COLOR_BOLD}$text"
        sleep 0.12
    done
    printf "\r${color}${COLOR_BOLD}$text${COLOR_RESET}\n"
}

