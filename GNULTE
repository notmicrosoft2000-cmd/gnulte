preview_sample() { echo -e "  ${1}preview${COLOR_RESET} ${COLOR_DIM}0123 abc${COLOR_RESET} ${COLOR_OK}OK${COLOR_RESET} ${COLOR_WARN}WARN${COLOR_RESET} ${COLOR_ERR}ERR${COLOR_RESET}"; }

pick_theme() {
    local t saved_themes=("classic" "hacker" "ocean" "sunset" "highcontrast" "mono" "custom")
    local saved_colors
    while :; do
        echo ""
        echo -e "${COLOR_BOLD}  Choose a colour theme${COLOR_RESET} ${COLOR_DIM}(live preview below)${COLOR_RESET}"
        echo ""
        local i=1
        for t in "${saved_themes[@]}"; do
            local marker=" "
            [ "$t" = "$CHOSEN_THEME" ] && marker="*"
            saved_colors=$(theme_color_lines "$t")
            # side-by-side: name then preview using that theme's colours
            eval "$saved_colors"
            printf "  %s %d) %-12s " "$marker" "$i" "$t"
            preview_sample "${COLOR_HEADER}"
            i=$((i+1))
        done
        # restore currently selected theme's colours for the rest of the app
        eval "$(theme_color_lines "$CHOSEN_THEME")"
        echo ""
        echo -e "  ${COLOR_DIM}custom = keep the colors hand-edited in ~/.gnulte.conf${COLOR_RESET}"
        read -p "  Select theme [1-7] ($CHOSEN_THEME): " tt
        case "$tt" in
            "") break ;;
            [1-9])
                n=$((tt-1))
                [ -n "${saved_themes[$n]:-}" ] && CHOSEN_THEME="${saved_themes[$n]}"
                ;;
            *) log_warn "  Invalid choice";;
        esac
    done
}

