}

log_err() {
    echo -e "${COLOR_ERR}[ERROR]${COLOR_RESET} $1" >&2
    session_log "[ERROR] $1"
}

log_cmd() {
    if [ "$LOG_MODE" = "simple" ] || [ "$LOG_MODE" = "quiet" ]; then
        return
    fi
    # easy mode hides raw commands, expert mode shows them prominently
    if [ "$VERBOSITY" = "easy" ]; then
        session_log "[EXEC] $1"
        return
    fi
    if [ "$VERBOSITY" = "expert" ]; then
        echo -e "${COLOR_ANIM}[EXEC]${COLOR_RESET} ${COLOR_CMD}$1${COLOR_RESET}"
    else
        echo -e "${COLOR_DIM}[EXEC]${COLOR_RESET} ${COLOR_CMD}$1${COLOR_RESET}"
    fi
    session_log "[EXEC] $1"
}

log_target() {
    [ "$LOG_MODE" = "quiet" ] && return
    echo -e "${COLOR_TARGET}[TARGET]${COLOR_RESET} $1"
    session_log "[TARGET] $1"
}

# Fuzzy, plain-language narration shown only in easy verbosity
say() {
    [ "$VERBOSITY" = "easy" ] || return
    echo -e "  ${COLOR_OK}✦${COLOR_RESET} $1"
}

# Expert mode pauses and asks before every consequential step
expert_confirm() {
    local msg="$1" raw="$2"
    if [ "$VERBOSITY" = "expert" ] && [ "$FORCE_MODE" = false ]; then
        echo -e "${COLOR_WARN}[EXPERT]${COLOR_RESET} ${COLOR_TARGET}$msg${COLOR_RESET}"
        echo -e "${COLOR_DIM}    raw: ${COLOR_CMD}$raw${COLOR_RESET}"
        read -p "    Run it? (y/n) [y]: " ans
        case "${ans:-y}" in
            n|N) return 1 ;;
        esac
    fi
    return 0
}

log_section() {
