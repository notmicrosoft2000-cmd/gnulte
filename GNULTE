# -----------------------------------------------------------------------------
# DEVICE IDENTIFICATION
# -----------------------------------------------------------------------------
# Resolve a device name using every available source. mDNS (avahi) usually
# reveals real product names on home LANs, then reverse DNS, then NetBIOS.
resolve_device_name() {
    local ip=$1
    local name=""

    # 1) mDNS / Bonjour – the most reliable source on home networks
    if command -v avahi-resolve-address &>/dev/null; then
        name=$(timeout 3 avahi-resolve-address "$ip" 2>/dev/null | awk '{print $2}' | head -1)
    fi

    # 2) Reverse DNS via systemd-resolved/hosts
    if [ -z "$name" ]; then
        name=$(getent hosts "$ip" 2>/dev/null | awk '{print $2}' | head -1)
    fi

    # 3) Reverse DNS via dig (if no local resolver answer)
    if [ -z "$name" ] && command -v dig &>/dev/null; then
        name=$(dig +short -x "$ip" 2>/dev/null | head -1 | sed 's/\.$//')
    fi

    # 4) Reverse DNS via host/nslookup
    if [ -z "$name" ] && command -v host &>/dev/null; then
        name=$(host "$ip" 2>/dev/null | head -1 | awk '{print $NF}' | sed 's/\.$//')
    fi
    if [ -z "$name" ] && command -v nslookup &>/dev/null; then
        name=$(nslookup "$ip" 2>/dev/null | grep "name =" | awk '{print $NF}' | sed 's/\.$//' | head -1)
    fi

    # 5) NetBIOS/SMB name (Windows PCs, NAS, printers)
    if [ -z "$name" ] && command -v nmblookup &>/dev/null; then
        name=$(timeout 3 nmblookup -A "$ip" 2>/dev/null | awk '$2=="<00>"||$2=="<20>"{print $1; exit}')
    fi

    # Clean up: strip trailing dots, drop useless results
    name=$(echo "$name" | sed 's/\.$//' | cut -c1-40)
    if [ -z "$name" ] || [ "$name" = "localhost" ] || [ "$name" = "$ip" ]; then
        echo "Unknown"
    else
        echo "$name"
    fi
}

# Map a MAC OUI vendor string (from arp-scan) to a human device type.
vendor_type() {
    local vendor="$1"
    local device_type="Unknown"
    if [ -z "$vendor" ] || [ "$vendor" = "Unknown" ]; then echo "Unknown"; return; fi

    # arp-scan emits vendors in UPPERCASE; normalize to lowercase for matching
    local v="${vendor,,}"

    case "$v" in
        # Routers / gateways / switches / APs (dedicated network gear)
        *frontiir*|*fiberhome*|*zte*|*zyxel*|*d-link*|*tp-link*|*tenda*|*mercusys*|*netgear*|*asus*|*asustek*|*linksys*|*belkin*|*cisco*|*ubiquiti*|*mikrotik*|*ruckus*|*aruba*|*ralink*|*sagemcom*|*technicolor*|*celeno*|*nokia*shanghai*|*archer*|*deco*|*mullions*|*zhongxing*|*arcadyan*|*totolink*|*sercomm*|*h3c*)
            device_type="Router" ;;

        # Apps / mobile
        *apple*)                          device_type="Apple" ;;
        *huawei*)                         device_type="Huawei" ;;
        *xiaomi*)                         device_type="Xiaomi" ;;
        *oppo*|*oneplus*|*vivo*|*bbk*)    device_type="Oppo/Vivo" ;;
        *google*)                         device_type="Google" ;;
        *samsung*electro*)                device_type="Samsung" ;;
        *nokia*|*alcatel*|*motorola*|*lenovo*mobile*) device_type="Phone" ;;
        *sony*mobile*|*sony*ericsson*)    device_type="Phone" ;;
        *lg*innotek*|*lg*electronics*)    device_type="LG" ;;

        # TVs / streaming
        *tcl*|*tte*|*tonly*|*vestel*)   device_type="TV" ;;
        *roku*|*hisense*)               device_type="TV/Streamer" ;;
        *sony*corporation*|*sony*corp*) device_type="Sony TV" ;;
        *panasonic*)                    device_type="TV" ;;

        # Smart speakers / assistants / IoT
        *amazon*|*echo*)                 device_type="Amazon Echo" ;;
        *nest*)                          device_type="Google Home" ;;
        *sonos*)                         device_type="Sonos Speaker" ;;
        *philips*|*signify*)             device_type="Philips Hue" ;;
        *bilian*|*billian*)              device_type="IoT" ;;
        *espressif*)                     device_type="ESP IoT" ;;
        *tuya*)                          device_type="Smart Plug/Light" ;;
        *azurewave*|*murata*)            device_type="IoT Module" ;;
        *texas*instruments*)             device_type="IoT" ;;
        *wistron*|*hon*hai*|*foxconn*)   device_type="Consumer IoT" ;;

        # Computers / laptops / single-board
        *raspberry*)                     device_type="Pi" ;;
        *intel*|*intel*corporate*)       device_type="PC" ;;
        *dell*|*hewlett*packard*|*hp*|*lenovo*|*acer*|*msi*|*giga-byte*|*asrock*|*toshiba*|*fujitsu*|*ibm*|*azw*|*compal*|*quanta*|*lite-on*|*pegatron*|*wistron*information*) device_type="Computer" ;;
        *nvidia*|*nvidia*)               device_type="NVIDIA" ;;

        # Printers
        *brother*|*epson*|*canon*|*xerox*|*ricoh*|*lexmark*|*hp*) device_type="Printer" ;;

        # IP cameras
        *vstarcam*|*hikvision*|*dahua*|*zhejiang*|*reolink*|*instar*|*amcrest*|*tapo*) device_type="IP Camera" ;;

        # Game consoles / media
        *sony*interactive*|*microsoft*|*nintendo*) device_type="Console" ;;

        *) device_type="Unknown" ;;
    esac

    echo "$device_type"
}

# Determine a human device type from the discovered name (mDNS/NetBIOS names
# are usually descriptive, e.g. "MiBox4", "DESKTOP-ABC123", "tapo-camera").
name_type() {
    local name="$1"
    local n="${name,,}"
    case "$n" in
        *tv*|*television*|*bravia*|*androidtv*|*google*cast*|*mibox*|*mi-tv*|*smarttv*|*webos*)      echo "Android TV" ;;
        *chromecast*)          echo "Chromecast" ;;
        *firestick*|*firetv*)  echo "FireTV" ;;
        *galaxy*|*samsung*|*redmi*|*pixel*|*iphone*|*huawei*|*mi*[0-9]*|*mi_*|*mi-*|*oppo*|*vivo*|*oneplus*|*lg-m*|*sm-*|*gt-*|*xt[0-9]*|*motorola*|*nokia[0-9]*) echo "Phone" ;;
        *desktop*|*laptop*|*pc-*|*pc_*|*-pc*|*notebook*|*workstat*) echo "Computer" ;;
        *server*|*nas*|*synology*|*qnap*|*raid*|*backup*)            echo "Server/NAS" ;;
        *printer*|*hp-*|*epson*|*brother-*|*canon-*|*laserjet*)      echo "Printer" ;;
        *camera*|*-cam*|*cam-*|*tapo*|*hikvision*|*reolink*|*dahua*|*cctv*|*ipc*) echo "Camera" ;;
        *echo*|*googlehome*|*google-home*|*nest*|*homepod*|*sonos*|*speaker*)    echo "Speaker" ;;
        *router*|*gateway*|*firewall*|*ap-*|*mikrotik*|*openwrt*|*fiberhome*|*cpe*) echo "Router" ;;
        *esp*|*espressif*|*sensor*|*shelly*|*plug*|*bulb*|*relay*|*switch*|*tuya*) echo "IoT" ;;
        *switch*|*hub-filter*)  echo "Network" ;;
        *) echo "Unknown" ;;
    esac
}

identify_device() {
    local ip=$1
    local vendor=$2
    local is_gateway=${3:-false}
    local hostname=""
    local device_type="Unknown"
    local ports=""

    hostname=$(resolve_device_name "$ip")

    if [ "$QUICK_SCAN" = false ]; then
        for p in 22 80 443 445 554 5555 8008 8080 8443 9000 32400; do
            timeout 1 bash -c 'exec 3<>"/dev/tcp/$1/$2"' _ "$ip" "$p" 2>/dev/null && ports="${ports}${p},"
        done
        ports=$(echo "$ports" | sed 's/,$//')
    fi

    # Gateway/router detection always wins
    if [ "$is_gateway" = true ]; then
        device_type="Router (Gateway)"
    else
        device_type=$(vendor_type "$vendor")
        # Names often tell more than the OUI vendor
        local ntype
        ntype=$(name_type "$hostname")
        if [ "$ntype" != "Unknown" ]; then
            case "$device_type" in
                Router|Router*) ;;                 # keep router/gateway
                Unknown) device_type="$ntype" ;;
                *)  [ "$ntype" = "Router" ] && device_type="Router" || true ;;
            esac
        fi
    fi

    [[ "$ports" == *"22"* ]] && device_type="$device_type+SSH"
    [[ "$ports" == *"80"* ]] && device_type="$device_type+HTTP"
    [[ "$ports" == *"443"* ]] && device_type="$device_type+HTTPS"
    [[ "$ports" == *"445"* ]] && device_type="$device_type+SMB"
    [[ "$ports" == *"554"* ]] && device_type="$device_type+RTSP(Camera)"
    [[ "$ports" == *"5555"* ]] && device_type="$device_type+ADB(Android)"
    [[ "$ports" == *"8008"* ]] || [[ "$ports" == *"8009"* ]] && device_type="$device_type+Cast(TV)"
    [[ "$ports" == *"32400"* ]] && device_type="$device_type+Plex"

    echo "$hostname|$device_type|$ports"
}

# -----------------------------------------------------------------------------
# DEEP SCAN
# -----------------------------------------------------------------------------
deep_scan() {
    local ip=$1
    local out ports_r os_result ports_result hostname_result
    log_info "Deep scanning $ip..."

    if ! command -v nmap &>/dev/null; then
        log_warn "nmap not installed. Install with: sudo apt install nmap"
        identify_device "$ip" "Unknown"
        return
    fi

    # Single structured (grepable -oG) run: OS fingerprint + open ports together.
    out=$(timeout 90 nmap -O -T4 -p 22,23,25,53,80,110,135,139,143,443,445,554,993,995,1433,3306,3389,5432,5555,5900,6379,8008,8080,8443,9000,32400 --open -oG - "$ip" 2>/dev/null)

    ports_result=$(grep -oP '\b[0-9]+(?=/open/tcp/)' <<< "$out" | sort -un | tr '\n' ',' | sed 's/,$//')
    [ -z "$ports_result" ] && ports_result="None"

    os_result=$(awk -F'OS: ' 'NF>1{print $2}' <<< "$out" | head -1 | cut -d'|' -f1 | sed -E 's/[[:space:]]*Seq:.*//')
    [ -z "$os_result" ] && os_result="Unknown"

    hostname_result=$(resolve_device_name "$ip")
    [ "$hostname_result" = "Unknown" ] && hostname_result="$ip"

    echo ""
    echo "  ${COLOR_BOLD}IP:${COLOR_RESET}        $ip"
    echo "  ${COLOR_BOLD}Hostname:${COLOR_RESET}   $hostname_result"
    echo "  ${COLOR_BOLD}OS:${COLOR_RESET}         $os_result"
    echo "  ${COLOR_BOLD}Open Ports:${COLOR_RESET} $ports_result"
    echo ""
}

