}

# Blinking-ready style pulse line
pulse_line() {
    local text="$1"
    local color="$2"
    for _ in 1 2 3 4; do
        printf "\r${color}${COLOR_BOLD}$text"
        sleep 0.12
        printf "\r${COLOR_DIM}${COLOR_BOLD}$text"
