valid_ip4() {
    local ip="$1" oct et
    [[ "$ip" =~ ^[0-9.]+$ ]] || return 1
    IFS=. read -ra oct <<< "$ip"
    [ "${#oct[@]}" -eq 4 ] || return 1
    for et in "${oct[@]}"; do
        [[ "$et" =~ ^[0-9]{1,3}$ ]] && [ "$et" -le 255 ] || return 1
    done
    return 0
}

valid_mac() {
    [[ "$1" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]]
}

cleanup_tmp() {
    [ -n "$TMP_DIR" ] && rm -rf "$TMP_DIR" 2>/dev/null
}
# Whatever happens (normal stop, error, crash), restore system state + temp files.
exit_handler() {
    cleanup_tmp
    cleanup
}
