BUILTIN_PROFILES[voip]="3000|200|0|0|5|0"
BUILTIN_PROFILES[web]="2000|400|3|0|0|0"
BUILTIN_PROFILES[extreme]="5000|1000|10|5|5|0"
BUILTIN_PROFILES[throttle]="500|200|0|0|0|512"

PROFILE_DESCRIPTIONS=(
    "gaming    : 1500ms latency, 300ms jitter, 2% loss"
    "streaming : 2500ms latency, 500ms jitter, 5% loss"
    "voip      : 3000ms latency, 200ms jitter, 5% reorder"
    "web       : 2000ms latency, 400ms jitter, 3% loss"
    "extreme   : 5000ms latency, 1000ms jitter, 10% loss, dup/reorder"
    "throttle  : 500ms latency, 512kbps bandwidth limit"
)

load_profile() {
    local name="$1"

    if [ -n "${BUILTIN_PROFILES[$name]}" ]; then
        IFS='|' read -r LATENCY JITTER LOSS DUPLICATE REORDER BANDWIDTH <<< "${BUILTIN_PROFILES[$name]}"
        log_info "Profile: ${COLOR_TARGET}$name${COLOR_RESET}"
        return 0
    fi

    if [ -n "${CUSTOM_PROFILES[$name]}" ]; then
        IFS='|' read -r LATENCY JITTER LOSS DUPLICATE REORDER BANDWIDTH <<< "${CUSTOM_PROFILES[$name]}"
        log_info "Custom profile: ${COLOR_TARGET}$name${COLOR_RESET}"
        return 0
    fi

    log_err "Unknown profile: $name"
    return 1
}

save_profile() {
    local name="$1"
    if [ -z "$name" ]; then
        log_err "Profile name required."
        return 1
    fi

    echo "CUSTOM_PROFILES[$name]=\"$LATENCY|$JITTER|$LOSS|$DUPLICATE|$REORDER|$BANDWIDTH\"" >> "$PROFILES_FILE"
    log_ok "Saved profile: $name"
}

show_profiles() {
    echo ""
    echo -e "${COLOR_BOLD}Available Profiles:${COLOR_RESET}"
    echo "  ──────────────────────────────────────────────────────────────────────"
    for p in "${PROFILE_DESCRIPTIONS[@]}"; do
        echo "    $p"
    done

    if [ -f "$PROFILES_FILE" ]; then
        local custom=$(grep -oP 'CUSTOM_PROFILES\[\K[^\]]+' "$PROFILES_FILE" 2>/dev/null)
        if [ -n "$custom" ]; then
            echo "  ──────────────────────────────────────────────────────────────────────"
            echo -e "  ${COLOR_DIM}Custom profiles:${COLOR_RESET}"
            while IFS= read -r line; do
                echo "    $line"
            done <<< "$custom"
        fi
    fi

    echo "  ──────────────────────────────────────────────────────────────────────"
    echo -e "${COLOR_DIM}Enter profile name, 'manual', or press Enter to skip.${COLOR_RESET}"
    echo ""
}

