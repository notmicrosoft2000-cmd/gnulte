# -----------------------------------------------------------------------------
# DETECT NETWORK
# -----------------------------------------------------------------------------
detect_network() {
    log_info "Detecting network configuration..."

    INTERFACE="$DEFAULT_INTERFACE"
    if [ -z "$INTERFACE" ]; then
        INTERFACE=$(ip route | grep default | awk '{print $5}' | head -1)
    fi

    if [ -z "$INTERFACE" ]; then
        log_err "Could not detect network interface."
        exit 1
    fi

    GATEWAY="$DEFAULT_GATEWAY"
    if [ -z "$GATEWAY" ]; then
        GATEWAY=$(ip route | grep default | awk '{print $3}' | head -1)
    fi

    if [ -z "$GATEWAY" ]; then
        log_err "Could not detect gateway."
        exit 1
    fi

    MY_IP=$(ip -4 addr show "$INTERFACE" | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -1)
    if [ -z "$MY_IP" ]; then
        log_err "Could not determine IP for interface $INTERFACE"
        exit 1
    fi

    # Resolve the gateway's MAC so we can always tag the router in the scan
    ping -c 1 -W 1 "$GATEWAY" >/dev/null 2>&1
    GATEWAY_MAC=$(ip neigh show "$GATEWAY" 2>/dev/null | grep -oP 'lladdr \K[0-9a-f:]{17}' | head -1)

    log_ok "Interface: $INTERFACE"
    log_ok "Gateway: $GATEWAY ${GATEWAY_MAC:+(MAC: $GATEWAY_MAC)}"
    log_ok "Your IP: $MY_IP"
    echo ""
}

# -----------------------------------------------------------------------------
# SCAN DEVICES
# -----------------------------------------------------------------------------
scan_devices() {
    log_info "Scanning for active devices..."

    if ! command -v arp-scan &>/dev/null; then
        log_err "arp-scan not found. Install with: sudo apt install arp-scan"
        exit 1
    fi

    if [ "$SCAN_MODE" = false ] && [ "$QUICK_SCAN" = false ]; then
        echo ""
        echo -e "${COLOR_DIM}Scan mode:${COLOR_RESET}"
        echo -e "  ${COLOR_DIM}1) Quick  - ARP only (fast, basic device info)${COLOR_RESET}"
        echo -e "  ${COLOR_DIM}2) Deep   - Port scan + hostname (slower, more detail)${COLOR_RESET}"
        read -p "Select scan mode (1-2) [1]: " SCAN_CHOICE
        if [[ "$SCAN_CHOICE" == "2" ]]; then
            SCAN_MODE=true
        else
            QUICK_SCAN=true
        fi
        echo ""
    fi

    ( sudo arp-scan --local > "$TMP_DIR/arp.txt" 2>/dev/null ) &
    local scan_pid=$!
    spinner "$scan_pid" "Running ARP scan..."
    wait "$scan_pid"

    ARP_OUTPUT=$(cat "$TMP_DIR/arp.txt")
    rm -f "$TMP_DIR/arp.txt"

    if [ -z "$ARP_OUTPUT" ]; then
        log_err "arp-scan returned no output. Check permissions."
        exit 1
    fi

    DEVICES=$(echo "$ARP_OUTPUT" | grep -E "([0-9]{1,3}\.){3}[0-9]{1,3}" | grep -v "Starting" | grep -v "packets received")

    IP_LIST=()
    MAC_LIST=()
    VENDOR_LIST=()
    HOSTNAME_LIST=()
    TYPE_LIST=()
    PORT_LIST=()

    local total=$(echo "$DEVICES" | wc -l)
    local current=0

    while IFS= read -r line; do
        current=$((current + 1))
        progress_bar "$current" "$total"

        IP=$(echo "$line" | awk '{print $1}')
        MAC=$(echo "$line" | awk '{print $2}')
        valid_ip4 "$IP" || continue
        valid_mac "$MAC" || continue
        VENDOR=$(echo "$line" | cut -d' ' -f3-)
        if [[ "$IP" != "$MY_IP" ]]; then
            IP_LIST+=("$IP")
            MAC_LIST+=("$MAC")
            VENDOR_LIST+=("$VENDOR")

            IS_GATEWAY=false
            if [[ "$IP" == "$GATEWAY" ]] || { [ -n "$GATEWAY_MAC" ] && [[ "$MAC" == "$GATEWAY_MAC" ]]; }; then
                IS_GATEWAY=true
            fi

            IDENT=$(identify_device "$IP" "$VENDOR" "$IS_GATEWAY")
            hostname=$(echo "$IDENT" | cut -d'|' -f1)
            DEV_TYPE=$(echo "$IDENT" | cut -d'|' -f2)
            PORTS=$(echo "$IDENT" | cut -d'|' -f3)

            HOSTNAME_LIST+=("$hostname")
            TYPE_LIST+=("$DEV_TYPE")
            PORT_LIST+=("$PORTS")
        fi
    done <<< "$DEVICES"
    echo ""

    if [ ${#IP_LIST[@]} -eq 0 ]; then
        log_err "No other devices found on the network."
        exit 1
    fi

    log_ok "Found ${#IP_LIST[@]} device(s)"
    echo ""
}

