        scan_devices
        display_devices
        echo "Select device to scan:"
        select_targets
        for IP in "${TARGETS[@]}"; do
            deep_scan "$IP"
        done
    fi
    exit 0
fi

if [ -n "$TARGET_RANGE" ]; then
    log_info "Scanning range: $TARGET_RANGE"

    if [ -n "$WHITELIST_INPUT" ]; then
        IFS=',' read -ra WHITELIST <<< "$WHITELIST_INPUT"
        log_info "Whitelist: ${WHITELIST[*]}"
    fi

    # Structured grepable (-oG) output, not the human table
    ( sudo nmap -sn -oG - "$TARGET_RANGE" 2>/dev/null > "$TMP_DIR/range.txt" ) &
    range_pid=$!
    spinner "$range_pid" "Scanning range..."
    wait "$range_pid"

    RANGE_IPS=$(sed -n 's/^Host: \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\) .*Status: Up$/\1/p' "$TMP_DIR/range.txt")
    rm -f "$TMP_DIR/range.txt"

    for IP in $RANGE_IPS; do
        valid_ip4 "$IP" || continue
        SKIP=false
        for W in "${WHITELIST[@]}"; do
            [[ "$IP" == "$W" ]] && SKIP=true && break
        done
        [ "$SKIP" = true ] && continue
        [[ "$IP" == "$MY_IP" ]] && continue
        TARGETS+=("$IP")
    done

    if [ ${#TARGETS[@]} -eq 0 ]; then
        log_err "No targets found in range (excluding whitelist/self)."
        exit 1
    fi
    log_target "Found ${#TARGETS[@]} targets in range"
    echo ""
fi

if [ "$DUPCHECK" = true ]; then
    check_duplicate_ips
    exit 0
fi

if [ -n "$TARGET_INPUT" ]; then
    TARGETS=()
    IFS=',' read -ra revised_parts <<< "$TARGET_INPUT"
    for revised in "${revised_parts[@]}"; do
        revised="${revised// /}"
        if ! valid_ip4 "$revised"; then
            log_err "Invalid target IP: '$revised'"
            exit 1
        fi
        TARGETS+=("$revised")
    done
    log_target "Direct target(s): ${TARGETS[*]}"
    echo ""
fi

if [ -n "$TARGET_MAC" ]; then
    if ! valid_mac "$TARGET_MAC"; then
        log_err "Invalid MAC address: '$TARGET_MAC' (expected aa:bb:cc:dd:ee:ff)"
        exit 1
    fi
    log_info "Resolving MAC: $TARGET_MAC"
    IP=$(ip neigh show 2>/dev/null | awk -v m="${TARGET_MAC,,}" 'tolower($5) == m { print $1; exit }')
    if [ -n "$IP" ] && valid_ip4 "$IP"; then
        TARGETS=("$IP")
        log_target "Resolved to IP: $IP"
    else
        log_err "Could not resolve MAC to IP. Is the device online?"
        exit 1
    fi
fi

if [ ${#TARGETS[@]} -eq 0 ]; then
    scan_devices
    display_devices
    select_targets
fi

if [ -n "$PROFILE" ]; then
    load_profile "$PROFILE" || exit 1
fi

LATENCY=${LATENCY:-$DEFAULT_LATENCY}
JITTER=${JITTER:-$DEFAULT_JITTER}
LOSS=${LOSS:-$DEFAULT_LOSS}
DUPLICATE=${DUPLICATE:-$DEFAULT_DUPLICATE}
REORDER=${REORDER:-$DEFAULT_REORDER}
BANDWIDTH=${BANDWIDTH:-$DEFAULT_BANDWIDTH}

verify_targets_reachable

if [ "$BLOCK_MODE" = true ]; then
    log_info "Block mode — parameter negotiation skipped (link is fully severed, no shaping)."
else
    if [ "$FORCE_MODE" = true ]; then
        estimate_impact "$LATENCY" "$JITTER" "$LOSS" "$DUPLICATE" "$REORDER" "$BANDWIDTH"
    else
        configure_params
    fi
fi

if ! validate_params; then
    log_err "Configuration rejected. Aborting."
    exit 1
fi

if [ -n "$SAVE_PROFILE" ]; then
    save_profile "$SAVE_PROFILE"
fi

safety_summary
if [ "$FORCE_MODE" = true ]; then
    echo -e "${COLOR_INFO}[--force] Starting automatically from explicit flags."
    echo -e "        Network-impacting operations still require first-run acknowledgment.${COLOR_RESET}"
    echo ""
else
    if [ ! -t 0 ]; then
        log_err "This test needs interactive confirmation. Run GNULTE from a terminal."
        exit 1
    fi
    read -p "Begin test? (y/N): " GO
    if [[ ! "$GO" =~ ^[Yy]$ ]]; then
        log_info "Aborted — no network operation was started."
        exit 0
    fi
    echo ""
fi

execute
monitor